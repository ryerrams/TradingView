//@version=6
// =====================================================================
//  ATR Stretch from 28 EMA  (label)  — port of the ThinkOrSwim study
//  ---------------------------------------------------------------------
//  Prints how far price is from the 28 EMA measured in ATR units:
//       factor = (close - EMA28) / ATR
//  +ve = price stretched ABOVE the EMA, -ve = BELOW. Bigger magnitude =
//  more extended (mean-reversion risk). Label colors scale with |factor|
//  the same way on both sides:
//       gray < 0.66 x Extended <= yellow < Extended <= red < Extreme <= fuchsia
//
//  Also stamps the factor on each bar as a small label: above the bar when
//  price is at/above the EMA, below it when price is under. By default only
//  the live bar gets one; turn on historical labels to see it on every bar.
//
//  BUY: the previous candle was Extended below the EMA
//  (factor[1] <= -Extended Threshold) AND this candle closes above the
//  previous candle's close. Fires once, on the first bar of the setup.
//  Turn "Confirm on Bar Close" off to fire intrabar (can repaint).
// =====================================================================
indicator("ATR Stretch from EMA", overlay=true, max_labels_count=500)

// ── Inputs ──────────────────────────────────────────────
emaLength         = input.int(28, "EMA Length", minval=1)
atrLength         = input.int(14, "ATR Length", minval=1)
atrAverageType    = input.string("Wilders", "ATR Average Type", options=["Wilders", "Simple", "Exponential", "Weighted", "Hull"])
extendedThreshold = input.float(2.0, "Extended Threshold (|factor|)", minval=0, step=0.1, tooltip="|factor| at/above this is flagged extended (red)")
extremeThreshold  = input.float(3.0, "Extreme Threshold (|factor|)", minval=0, step=0.1, tooltip="|factor| at/above this is flagged extreme (fuchsia), above or below the EMA")
showEma           = input.bool(false, "Show EMA on Price")
confirmOnClose    = input.bool(true, "BUY: Confirm on Bar Close", tooltip="Off = BUY can fire intrabar and disappear if price falls back (like ToS). On = only once the bar has closed.")
showBuyBubble     = input.bool(true, "Show BUY Arrow + Bubble")
buyKeepBars       = input.int(12, "BUY: Keep Last N Bars (0 = all)", minval=0, maxval=5000, tooltip="BUY arrows and bubbles older than this many bars are removed, so only recent BUYs stay on the chart. 0 = no bar limit (Current Day Only still applies).")
buyTodayOnly      = input.bool(true, "BUY: Current Day Only", tooltip="On = BUY arrows and bubbles from earlier trading days are removed when a new trading day starts (18:00 ET on CME futures). Off = keep every BUY on the chart. Alerts are not affected.")
showFactorLabels  = input.bool(true, "Show Per-Bar Factor Labels")
showHistFactor    = input.bool(false, "Factor Labels on Historical Bars", tooltip="Off = only the live bar gets a factor label.")
factorSizeInput   = input.string("Small", "Factor Label Size", options=["Tiny", "Small", "Normal"])
labelPos          = input.string("Top Right", "Label Position", options=["Top Left", "Top Center", "Top Right", "Bottom Left", "Bottom Center", "Bottom Right"])
labelOffset       = input.float(6.0, "Label Edge Offset (% of pane)", minval=0, maxval=50, step=0.5, tooltip="Pushes the label away from the pane edge. Stack it with other top-right panels without overlap (Soma ICT 0, this label 6, Daily Bias readout 10).")
labelSizeInput    = input.string("Normal", "Label Text Size", options=["Small", "Normal", "Large"])
stackLines        = input.int(7, "Stack Below (text lines)", minval=0, maxval=40, tooltip="Top positions: leave this many lines of small text above the label, so it sits under other top-right panels at any pane height. 7 = below the Soma ICT panel and its edge offset at Normal text size. 0 = use Label Edge Offset (% of pane) instead.")

// ── Calculation ─────────────────────────────────────────
tr  = ta.tr(true)
atr = switch atrAverageType
    "Simple"      => ta.sma(tr, atrLength)
    "Exponential" => ta.ema(tr, atrLength)
    "Weighted"    => ta.wma(tr, atrLength)
    "Hull"        => ta.hma(tr, atrLength)
    => ta.rma(tr, atrLength)

ema    = ta.ema(close, emaLength)
factor = atr == 0 ? 0.0 : (close - ema) / atr

stretchColor(float f) =>
    a = math.abs(f)
    a >= extremeThreshold ? color.fuchsia : a >= extendedThreshold ? color.red : a >= extendedThreshold * 0.66 ? color.yellow : color.gray

// Black text only on yellow; white reads better on gray / red / fuchsia
textColorFor(color bg) =>
    bg == color.yellow ? color.black : color.white

// ── BUY setup: previous candle Extended below the EMA AND this candle closes above the previous close ──
prevFactor = factor[1]
extended   = prevFactor <= -extendedThreshold     // previous candle at least Extended Threshold ATR BELOW the EMA
reclaim    = close > close[1]                     // this candle closes above the previous candle's close
rawBuy    = extended and reclaim
buyNow    = rawBuy and not rawBuy[1] and (not confirmOnClose or barstate.isconfirmed)   // fire once, when the setup first triggers

// ── EMA ─────────────────────────────────────────────────
plot(showEma ? ema : na, "EMA", color=color.yellow)

// ── BUY arrow + bubble ──────────────────────────────────
showBuy = showBuyBubble and buyNow
// The arrow is a label (not plotshape) so earlier days' arrows can be removed.
// Keep a single arrow + bubble per bar: on the live bar the setup can flicker,
// so they are created once and updated / removed as the bar evolves.
var label buyLbl = na
var label buyArw = na
var array<label> buyMarks = array.new<label>()   // every BUY arrow + bubble still on the chart
var array<int>   buyMarkBars = array.new<int>()  // bar each mark was drawn on (for Keep Last N Bars)
if buyTodayOnly and time_tradingday != time_tradingday[1]
    for m in buyMarks
        label.delete(m)
    buyMarks.clear()
    buyMarkBars.clear()
if buyKeepBars > 0
    while buyMarkBars.size() > 0 and bar_index - buyMarkBars.first() >= buyKeepBars
        label.delete(buyMarks.shift())
        buyMarkBars.shift()
if barstate.isnew
    buyLbl := na
    buyArw := na
if showBuy
    txt = "BUY\n" + str.tostring(math.abs(prevFactor), "0.0") + "x ATR"
    if na(buyLbl)
        buyLbl := label.new(bar_index, low - atr * 0.5, txt, style=label.style_label_up, color=color.green, textcolor=color.white)
        buyArw := label.new(bar_index, low - atr * 0.25, "", style=label.style_arrowup, color=color.green, size=size.normal)
        buyMarks.push(buyLbl)
        buyMarks.push(buyArw)
        buyMarkBars.push(bar_index)
        buyMarkBars.push(bar_index)
    else
        label.set_xy(buyLbl, bar_index, low - atr * 0.5)
        label.set_text(buyLbl, txt)
        label.set_xy(buyArw, bar_index, low - atr * 0.25)
else if not na(buyLbl)
    label.delete(buyLbl)
    label.delete(buyArw)
    buyLbl := na
    buyArw := na

alertcondition(buyNow, "ATR reversion BUY", "ATR reversion BUY on {{ticker}} ({{interval}})")
if buyNow
    alert("ATR reversion BUY: " + syminfo.ticker + " " + str.tostring(math.abs(prevFactor), "0.0") + "x ATR below " + str.tostring(emaLength) + " EMA", alert.freq_once_per_bar)

// ── Per-bar factor label: above the bar when price >= EMA, below when under ──
// Skipped on BUY bars so it doesn't overlap the BUY bubble.
factorSize = factorSizeInput == "Tiny" ? size.tiny : factorSizeInput == "Normal" ? size.normal : size.small
var label prevFactorLbl = na
if showFactorLabels and not showBuy
    aboveEma = close >= ema
    fColor   = stretchColor(factor)
    fLbl = label.new(bar_index, aboveEma ? high + atr * 0.25 : low - atr * 0.25,
         (factor >= 0 ? "+" : "") + str.tostring(factor, "0.0") + "x",
         style=aboveEma ? label.style_label_down : label.style_label_up,
         color=fColor, textcolor=textColorFor(fColor), size=factorSize)
    if not showHistFactor
        label.delete(prevFactorLbl)
    prevFactorLbl := fLbl

// ── Stretch label (TOS AddLabel equivalent) ─────────────
lblColor = stretchColor(factor)
txtColor = textColorFor(lblColor)

pos = switch labelPos
    "Top Left"      => position.top_left
    "Top Center"    => position.top_center
    "Bottom Left"   => position.bottom_left
    "Bottom Center" => position.bottom_center
    "Bottom Right"  => position.bottom_right
    => position.top_right

isTop     = str.startswith(labelPos, "Top")
labelSize = labelSizeInput == "Small" ? size.small : labelSizeInput == "Large" ? size.large : size.normal

// Two rows: an empty spacer row on the pane-edge side, then the label itself.
var table tbl = table.new(pos, 1, 2)
if barstate.islast
    dist = close - ema
    lblText = "Px vs " + str.tostring(emaLength) + "EMA: " + (factor >= 0 ? "+" : "") + str.tostring(factor, "0.00") + "x ATR" + "  (" + (dist >= 0 ? "+" : "") + str.tostring(dist, "0.00") + " pt)"
    spacerRow = isTop ? 0 : 1
    labelRow  = isTop ? 1 : 0
    if isTop and stackLines > 0
        string sp = " "
        for k = 2 to stackLines
            sp += "\n "
        table.cell(tbl, 0, spacerRow, sp, text_size=size.small, bgcolor=color.new(color.black, 100))
    else if labelOffset > 0
        table.cell(tbl, 0, spacerRow, "", height=labelOffset)
    table.cell(tbl, 0, labelRow, lblText, bgcolor=lblColor, text_color=txtColor, text_size=labelSize)

// Data-window value so the factor can be read on any bar
plot(factor, "Stretch Factor (x ATR)", display=display.data_window)
