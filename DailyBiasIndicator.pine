//@version=6
// Daily Bias Indicator — Pine v6 port of the NinjaTrader 8 DailyBiasIndicator.cs
//
// Plots a single letter under price at a configurable interval (default every
// 30 minutes from session start): L (Long bias), S (Short bias), or N (Neutral),
// computed from where price sits relative to the PRIOR session's Value Area.
// The value area is built from bar data (typical price weighted by bar volume,
// bucketed into fixed-size price bins) — no tick data required.
//
// Bias logic:
//   - Close > prior VAH -> leaning Long
//   - Close < prior VAL -> leaning Short
//   - otherwise         -> Neutral (applied immediately, no confirmation delay)
// A Long/Short lean becomes the confirmed bias only after holding for
// "Flip Confirmation Bars" consecutive bars.
//
// With the intraday qualifier on, "l" / "s" mean the macro bias is Long/Short
// but price is on the wrong side of TODAY's developing POC.
//
// Letters: bright color = the confirmed bias changed since the last letter,
// dim color = continuation of the same bias.
//
// Auction Market Theory rotation labels (port of the NT8 indicator's
// RotationState machine; text-only markers, no orders):
//   - FAILED BREAKOUT: bar's high pokes above prior VAH + Zone Width but the
//     bar CLOSES back at/below VAH (wick-based, edge-triggered) -> "Failed
//     Breakout / Target: Prior VAL" and a watch down to VAL (SHORT idea).
//   - FAILED BREAKDOWN: mirror -> "Target: Prior VAH" (LONG idea).
//   - While watching: "Crossing POC" once price closes through the prior POC;
//     "Rotation Complete" when the opposite edge trades; "Rotation Stalled
//     (reversed early)" if price rebounds Stall Rebound pts off its best
//     price; the watch is silently cancelled if the confirmed bias breaks back
//     out the original way.
//   - SUCCESSFUL BREAKOUT/BREAKDOWN: the confirmed (close-held) bias flips to
//     Long/Short; also cancels any rotation watch.
// The readout's second line tells you what to do at these levels this session.
// Prior levels carry forward the last smoothed live VA (volume-spike cap +
// per-bar smoothing), exactly like the NT indicator.
//
// Also draws the prior session's VAH/POC/VAL as flat reference lines, today's
// developing VAH/POC/VAL (default: short stubs at the live bar only, so the
// stair-stepping history doesn't clutter the chart), right-edge price tags,
// optional entry/exit bubbles, and a one-line readout strip (current bias +
// prior VAH/POC/VAL).
//
// Differences vs. the NT8 original:
//   - Today's live VA is always computed (the letter/bubble qualifiers need it);
//     "Today's VAH/POC/VAL" only controls how (or whether) it's drawn.
//   - Session boundaries follow the chart's session setting (RTH vs ETH),
//     the equivalent of NT's trading-hours template.
//   - On the live bar, values update intrabar and settle at bar close (Pine
//     rolls back uncommitted state, so the final result matches OnBarClose).
indicator("Daily Bias Indicator", shorttitle="DailyBias", overlay=true, max_labels_count=500, max_lines_count=500)

// ── Inputs ──────────────────────────────────────────────
grpP = "Parameters"
grpV = "Visuals"
grpC = "Colors"
grpF = "Failed Auction"
grpL = "Labels"

plotInterval   = input.int(30, "Plot Interval (minutes)", minval=0, maxval=240, group=grpP, tooltip="0 = print a letter on every bar")
vaPct          = input.float(0.70, "Value Area %", minval=0.5, maxval=0.95, step=0.05, group=grpP)
bucketPts      = input.float(1.0, "Profile Bucket Size (pts)", minval=0.25, maxval=20.0, step=0.25, group=grpP)
flipBars       = input.int(2, "Flip Confirmation Bars", minval=1, maxval=20, group=grpP)
useQual        = input.bool(true, "Use Intraday Structure Qualifier (L/l, S/s vs today's POC)", group=grpP)

showRef        = input.bool(true, "Show Prior VAH/POC/VAL Lines", group=grpV)
liveMode       = input.string("Stubs", "Today's VAH/POC/VAL", options=["Stubs", "Full History", "Off"], group=grpV, tooltip="Stubs = short line + price tag at the live bar only. Full History = the developing levels plotted across the whole session (stair-steps as the profile builds).")
stubBars       = input.int(8, "Today Stub Length (bars)", minval=1, maxval=100, group=grpV)
showTags       = input.bool(true, "Show Price Tags on Level Lines", group=grpL)
letterOffset   = input.int(6, "Letter Offset (ticks below bar)", minval=0, maxval=50, group=grpL)
lblSizeIn      = input.string("Normal", "Label Text Size (signal pills; notes/tags/bubbles are one step smaller)", options=["Small", "Normal", "Large"], group=grpL)
letterKeepBars  = input.int(10, "Bias Letters: keep only the last N bars (0 = all history)", minval=0, maxval=5000, group=grpL, tooltip="Older letters are deleted as the chart advances, so only the most recent ones stay visible.")
bubbleKeepBars  = input.int(60, "Entry/Exit Bubbles: keep only the last N bars (0 = all history)", minval=0, maxval=5000, group=grpL)
faKeepBars      = input.int(60, "Failed-Auction Signals: keep only the last N bars (0 = all history)", minval=0, maxval=5000, group=grpL, tooltip="Applies to the Failed Breakout/Breakdown pills, POC / Target / Stalled / Accepted notes, and the dotted target lines.")
letterSizeIn   = input.string("Normal", "Letter Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=grpL)
showBubbles    = input.bool(true, "Show Long/Short Entry-Exit Bubbles", group=grpV)
useQualBubbles = input.bool(true, "Bubbles React to Today's POC (not just macro flips)", group=grpV)
pillOffset     = input.int(40, "Failed-Auction Pill Offset (ticks from bar, kept clear of bubbles/notes)", minval=0, maxval=300, group=grpL)
bubbleOffset   = input.int(14, "Bubble Offset (ticks from bar)", minval=0, maxval=100, group=grpL)
showReadout    = input.bool(true, "Show Readout Strip", group=grpV)
readoutPos     = input.string("Bottom Right", "Readout Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=grpV, tooltip="Defaults to Bottom Right so it never collides with the other top-right tables (ATR Stretch, LASOMA). Existing charts keep their saved position: change it here.")
readoutOffset  = input.float(3.0, "Readout Edge Offset (% of pane)", minval=0, maxval=50, step=0.5, group=grpV, tooltip="Distance from the pane edge. Nudge up/down (0.5 steps) to sit flush under the ATR Stretch label on your pane height.")
readoutSizeIn  = input.string("Large", "Readout Text Size", options=["Small", "Normal", "Large"], group=grpV)

showFA         = input.bool(true, "Show Failed Auction Signals", group=grpF, tooltip="Wick past prior VAH/VAL +/- Zone Width that closes back inside: failed breakout = short to prior VAL, failed breakdown = long to prior VAH.")
faZoneTicks    = input.int(8, "VAH/VAL Zone Width (ticks each side; past it = probe)", minval=0, maxval=100, group=grpF)
faStallPts     = input.float(15.0, "Rotation Stall Rebound (pts before giving up on target)", minval=0.0, maxval=200.0, group=grpF)
faDedupe       = input.bool(true, "Suppress Repeat Signals", group=grpF, tooltip="No new failed breakout while a 'to VAL' rotation is already open (same for breakdowns), and no repeat of the same signal within the cooldown. Turn off to match the NinjaTrader indicator exactly, which re-fires on every re-arm.")
faCooldown     = input.int(6, "Repeat Cooldown (bars)", minval=0, maxval=100, group=grpF)
faTargetLine   = input.bool(true, "Draw Signal-to-Target Dotted Line", group=grpF)
faShowPoc      = input.bool(false, "Show 'Crossing POC' Marker", group=grpL)
faShowDir      = input.bool(true, "Show Direction Line in Readout", group=grpF)

spikeGuard     = input.bool(true, "Guard Against Volume Spikes", group=grpP)
spikeLookback  = input.int(20, "Volume Spike Lookback (bars)", minval=2, maxval=100, group=grpP)
spikeMult      = input.float(5.0, "Max Volume Spike Multiplier", minval=1.0, maxval=50.0, group=grpP)
smoothVa       = input.bool(true, "Smooth Value Area (rate limit jumps)", group=grpP)
maxMovePts     = input.float(5.0, "Max Move Per Bar (pts, 0 = unlimited)", minval=0.0, maxval=200.0, group=grpP)

flipLongCol    = input.color(#3DDC97,     "Flip to Long", group=grpC)
contLongCol    = input.color(#2E8B6A,     "Continuation Long", group=grpC)
flipShortCol   = input.color(#FF5C6C,     "Flip to Short", group=grpC)
contShortCol   = input.color(#B5505B,     "Continuation Short", group=grpC)
flipNeutralCol = input.color(#E6E8EB,     "Flip to Neutral", group=grpC)
contNeutralCol = input.color(#8B919A,     "Continuation Neutral", group=grpC)
enterLongCol   = input.color(#2EBD85,     "Enter Long Bubble", group=grpC)
exitLongCol    = input.color(#F0883E,     "Exit Long Bubble", group=grpC)
enterShortCol  = input.color(#F6465D,     "Enter Short Bubble", group=grpC)
exitShortCol   = input.color(#4DB6FF,     "Exit Short Bubble", group=grpC)
failBoCol      = input.color(#FF7A59,     "Failed Breakout Label", group=grpC)
failBdCol      = input.color(#4DB6FF,     "Failed Breakdown Label", group=grpC)
pocCrossCol    = input.color(#F5C451,     "Rotation POC-Cross Label", group=grpC)
rotDoneCol     = input.color(#E6E8EB,     "Rotation Complete Label", group=grpC)
rotStallCol    = input.color(#B388FF,     "Rotation Stalled Label", group=grpC)
succBoCol      = input.color(#3DDC97,     "Successful Breakout Label", group=grpC)
succBdCol      = input.color(#FF5C6C,     "Successful Breakdown Label", group=grpC)
priorVaCol     = input.color(#4C9AFF,     "Prior VAH/VAL Line", group=grpC)
priorPocCol    = input.color(#F5C451,     "Prior POC Line", group=grpC)
liveVahCol     = input.color(#5CE1E6,     "Today VAH", group=grpC)
livePocCol     = input.color(#FFE066, "Today POC", group=grpC)
liveValCol     = input.color(#E070FF,     "Today VAL", group=grpC)

pillSz = lblSizeIn == "Small" ? size.small : lblSizeIn == "Normal" ? size.normal : size.large
noteSz = lblSizeIn == "Large" ? size.normal : size.small
letterSize = letterSizeIn == "Tiny" ? size.tiny : letterSizeIn == "Small" ? size.small : letterSizeIn == "Normal" ? size.normal : letterSizeIn == "Large" ? size.large : size.huge

enum Bias
    neutral
    long
    short

// ── Value Area calc ─────────────────────────────────────
// Expand from the POC by whichever adjacent bucket has more volume until
// vaPct of total volume is captured. Returns [vah, poc, val] (na if empty).
valueArea(map<float, float> hist, float pct) =>
    float vah = na
    float poc = na
    float val = na
    if hist.size() > 0
        keys = hist.keys()   // copy, in insertion order
        float total  = 0.0
        float maxVol = -1.0
        float pocKey = na
        for k in keys
            v = hist.get(k)
            total += v
            if v > maxVol    // strict > keeps the first-inserted key on ties (matches LINQ stable sort)
                maxVol := v
                pocKey := k
        if total > 0
            keys.sort(order.ascending)
            int pocIdx = keys.indexof(pocKey)
            int upIdx  = pocIdx
            int loIdx  = pocIdx
            float vahL = pocKey
            float valL = pocKey
            float cum  = maxVol
            while cum < total * pct
                bool hasUp = upIdx + 1 < keys.size()
                bool hasLo = loIdx - 1 >= 0
                if not hasUp and not hasLo
                    break
                float upVol = -1.0
                float loVol = -1.0
                if hasUp
                    upVol := hist.get(keys.get(upIdx + 1))
                if hasLo
                    loVol := hist.get(keys.get(loIdx - 1))
                if upVol >= loVol
                    upIdx += 1
                    vahL := keys.get(upIdx)
                    cum += upVol
                else
                    loIdx -= 1
                    valL := keys.get(loIdx)
                    cum += loVol
            vah := vahL
            poc := pocKey
            val := valL
    [vah, poc, val]

clampMove(float prev, float target, float maxMove) =>
    float d = target - prev
    d > maxMove ? prev + maxMove : d < -maxMove ? prev - maxMove : target

trackLbl(array<label> lbls, array<int> bars, label lb) =>
    lbls.push(lb)
    bars.push(bar_index)
    lb

trackLn(array<line> lns, array<int> bars, line ln) =>
    lns.push(ln)
    bars.push(bar_index)
    ln

pruneLbls(array<label> lbls, array<int> bars, int keep) =>
    if keep > 0
        while bars.size() > 0 and bar_index - bars.first() >= keep
            label.delete(lbls.shift())
            bars.shift()

pruneLns(array<line> lns, array<int> bars, int keep) =>
    if keep > 0
        while bars.size() > 0 and bar_index - bars.first() >= keep
            line.delete(lns.shift())
            bars.shift()

// ── State ───────────────────────────────────────────────
var map<float, float> volumeByPrice = map.new<float, float>()

var float priorVah = na
var float priorVal = na
var float priorPoc = na
var bool  havePrior = false
var int   sessionStartBar = 0
var int   sessionStartTime = time

var Bias  rawLean = Bias.neutral
var int   leanStreak = 0
var Bias  confirmed = Bias.neutral
var Bias  lastPrinted = Bias.neutral
var bool  prevStrongLong = false
var bool  prevStrongShort = false
var float lastCheckpointElapsed = -1.0
var array<label> letterLbls = array.new<label>()
var array<int>   letterBars = array.new<int>()
var array<label> faLbls = array.new<label>()
var array<int>   faBars = array.new<int>()
var array<line>  faLns = array.new<line>()
var array<int>   faLnBars = array.new<int>()
var array<label> bubLbls = array.new<label>()
var array<int>   bubBars = array.new<int>()

// Smoothed live VA carried forward as the prior session (strategy's FinalizePriorSession)
var float lastVah = na
var float lastPoc = na
var float lastVal = na
var bool  haveLive = false

// Failed-auction state (reset each session)
var bool  prevRejUp = false
var bool  prevRejDn = false
var int   lastFailUpBar = -1000
var int   lastFailDnBar = -1000
var int   rotDir = 0         // -1 watching down to VAL (short idea), +1 watching up to VAH (long idea)
var float rotExtreme = na
var bool  pocCrossed = false
var line  tradeLn = na

var box  bxVah = na
var line lnPoc = na
var box  bxVal = na

// ── Session rollover ────────────────────────────────────
if session.isfirstbar or bar_index == 0
    sessionStartBar := bar_index
    if haveLive
        priorVah  := lastVah
        priorPoc  := lastPoc
        priorVal  := lastVal
        havePrior := true
    haveLive := false
    volumeByPrice.clear()
    rawLean               := Bias.neutral
    leanStreak            := 0
    confirmed             := Bias.neutral
    lastPrinted           := Bias.neutral
    prevStrongLong        := false
    prevStrongShort       := false
    lastCheckpointElapsed := -1.0
    prevRejUp   := false
    prevRejDn   := false
    rotDir      := 0
    rotExtreme  := na
    pocCrossed  := false
    tradeLn     := na
    sessionStartTime      := time
    bxVah := na
    lnPoc := na
    bxVal := na

float liveVah = na
float livePoc = na
float liveVal = na
float avgVol  = ta.sma(volume, spikeLookback)
bool  sigShort = false
bool  sigLong  = false

if bar_index >= 2
    // Accumulate this bar into today's histogram
    if not na(volume) and volume > 0
        float vol = volume
        if spikeGuard and bar_index >= spikeLookback and avgVol > 0 and vol > avgVol * spikeMult
            vol := avgVol * spikeMult
        bucket = math.round(hlc3 / bucketPts) * bucketPts
        volumeByPrice.put(bucket, nz(volumeByPrice.get(bucket)) + vol)

    // Today's developing VAH/POC/VAL
    if volumeByPrice.size() > 0
        [a, b, c] = valueArea(volumeByPrice, vaPct)
        liveVah := a
        livePoc := b
        liveVal := c
        if smoothVa and maxMovePts > 0 and haveLive
            liveVah := clampMove(lastVah, a, maxMovePts)
            livePoc := clampMove(lastPoc, b, maxMovePts)
            liveVal := clampMove(lastVal, c, maxMovePts)
        lastVah  := liveVah
        lastPoc  := livePoc
        lastVal  := liveVal
        haveLive := true

    if havePrior
        Bias curRaw = close > priorVah ? Bias.long : close < priorVal ? Bias.short : Bias.neutral
        if curRaw == rawLean
            leanStreak += 1
        else
            rawLean    := curRaw
            leanStreak := 1

        Bias prevConfirmed = confirmed
        if rawLean != Bias.neutral and leanStreak >= flipBars
            confirmed := rawLean
        else if rawLean == Bias.neutral
            confirmed := Bias.neutral   // back inside value area = neutral immediately

        if showBubbles
            haveToday     = useQualBubbles and volumeByPrice.size() > 0
            aboveTodayPoc = haveToday and close > livePoc

            // "Strong" = confirmed macro bias AND (if qualifier on) on the right side of today's POC.
            curStrongLong  = confirmed == Bias.long  and (not haveToday or aboveTodayPoc)
            curStrongShort = confirmed == Bias.short and (not haveToday or not aboveTodayPoc)

            belowY = low  - bubbleOffset * syminfo.mintick
            aboveY = high + bubbleOffset * syminfo.mintick

            if curStrongLong and not prevStrongLong
                trackLbl(bubLbls, bubBars, label.new(bar_index, belowY, "Long", yloc=yloc.price, style=label.style_label_up, color=enterLongCol, textcolor=color.black, size=noteSz))
            if prevStrongLong and not curStrongLong
                trackLbl(bubLbls, bubBars, label.new(bar_index, aboveY, "Exit Long", yloc=yloc.price, style=label.style_label_down, color=exitLongCol, textcolor=color.white, size=noteSz))
            if curStrongShort and not prevStrongShort
                trackLbl(bubLbls, bubBars, label.new(bar_index, aboveY, "Short", yloc=yloc.price, style=label.style_label_down, color=enterShortCol, textcolor=color.white, size=noteSz))
            if prevStrongShort and not curStrongShort
                trackLbl(bubLbls, bubBars, label.new(bar_index, belowY, "Exit Short", yloc=yloc.price, style=label.style_label_up, color=exitShortCol, textcolor=color.black, size=noteSz))

            prevStrongLong  := curStrongLong
            prevStrongShort := curStrongShort

        if showFA
            zone  = faZoneTicks * syminfo.mintick
            aboveY = high + bubbleOffset * syminfo.mintick
            belowY = low  - bubbleOffset * syminfo.mintick
            pillAboveY = high + pillOffset * syminfo.mintick
            pillBelowY = low  - pillOffset * syminfo.mintick

            // Successful breakout/breakdown = the confirmed bias flips to Long/Short; voids any rotation watch
            if prevConfirmed != Bias.long and confirmed == Bias.long
                trackLbl(faLbls, faBars, label.new(bar_index, belowY, "Accepted higher ↑", yloc=yloc.price, style=label.style_none, textcolor=succBoCol, size=noteSz))
                rotDir := 0
            else if prevConfirmed != Bias.short and confirmed == Bias.short
                trackLbl(faLbls, faBars, label.new(bar_index, aboveY, "Accepted lower ↓", yloc=yloc.price, style=label.style_none, textcolor=succBdCol, size=noteSz))
                rotDir := 0

            // Wick-based, edge-triggered probe-and-reject
            rejUpNow = high > priorVah + zone and close <= priorVah
            rejDnNow = low  < priorVal - zone and close >= priorVal
            dupUp    = faDedupe and (rotDir == -1 or bar_index - lastFailUpBar < faCooldown)
            dupDn    = faDedupe and (rotDir == 1  or bar_index - lastFailDnBar < faCooldown)
            failUp   = rejUpNow and not prevRejUp and not dupUp
            failDn   = rejDnNow and not prevRejDn and not dupDn
            prevRejUp := rejUpNow
            prevRejDn := rejDnNow

            if failUp
                lastFailUpBar := bar_index
                rotDir     := -1
                pocCrossed := false
                rotExtreme := low
                sigShort   := true
                trackLbl(faLbls, faBars, label.new(bar_index, pillAboveY, "Failed Breakout → VAL", yloc=yloc.price, style=label.style_label_down, color=color.new(failBoCol, 12), textcolor=#0B0E11, size=pillSz))
                if faTargetLine
                    tradeLn := trackLn(faLns, faLnBars, line.new(bar_index, close, bar_index, priorVal, color=color.new(failBoCol, 35), style=line.style_dotted, width=1))
            else if failDn
                lastFailDnBar := bar_index
                rotDir     := 1
                pocCrossed := false
                rotExtreme := high
                sigLong    := true
                trackLbl(faLbls, faBars, label.new(bar_index, pillBelowY, "Failed Breakdown → VAH", yloc=yloc.price, style=label.style_label_up, color=color.new(failBdCol, 12), textcolor=#0B0E11, size=pillSz))
                if faTargetLine
                    tradeLn := trackLn(faLns, faLnBars, line.new(bar_index, close, bar_index, priorVah, color=color.new(failBdCol, 35), style=line.style_dotted, width=1))

            // Follow the rotation
            if rotDir != 0 and not na(tradeLn)
                tradeLn.set_x2(bar_index)
            if rotDir == -1
                rotExtreme := math.min(rotExtreme, low)
                if faShowPoc and not pocCrossed and close <= priorPoc
                    pocCrossed := true
                    trackLbl(faLbls, faBars, label.new(bar_index, aboveY, "POC", yloc=yloc.price, style=label.style_none, textcolor=pocCrossCol, size=noteSz))
                if low <= priorVal
                    trackLbl(faLbls, faBars, label.new(bar_index, belowY, "✓ Target · VAL", yloc=yloc.price, style=label.style_none, textcolor=rotDoneCol, size=noteSz))
                    rotDir := 0
                else if confirmed == Bias.long
                    rotDir := 0     // reclaimed VAH again, thesis voided
                else if close - rotExtreme >= faStallPts
                    trackLbl(faLbls, faBars, label.new(bar_index, belowY, "Stalled", yloc=yloc.price, style=label.style_none, textcolor=rotStallCol, size=noteSz))
                    rotDir := 0
            else if rotDir == 1
                rotExtreme := math.max(rotExtreme, high)
                if faShowPoc and not pocCrossed and close >= priorPoc
                    pocCrossed := true
                    trackLbl(faLbls, faBars, label.new(bar_index, belowY, "POC", yloc=yloc.price, style=label.style_none, textcolor=pocCrossCol, size=noteSz))
                if high >= priorVah
                    trackLbl(faLbls, faBars, label.new(bar_index, aboveY, "✓ Target · VAH", yloc=yloc.price, style=label.style_none, textcolor=rotDoneCol, size=noteSz))
                    rotDir := 0
                else if confirmed == Bias.short
                    rotDir := 0     // lost VAL again, thesis voided
                else if rotExtreme - close >= faStallPts
                    trackLbl(faLbls, faBars, label.new(bar_index, aboveY, "Stalled", yloc=yloc.price, style=label.style_none, textcolor=rotStallCol, size=noteSz))
                    rotDir := 0

    // Prior session VAH/POC/VAL as flat lines spanning the current session
    if showRef and havePrior
        x1 = bar_index - math.max(1, bar_index - sessionStartBar)
        zb = faZoneTicks * syminfo.mintick
        // VAH/VAL as shaded zones (+/- Zone Width), POC as an exact line
        if na(bxVah)
            bxVah := box.new(x1, priorVah + zb, bar_index, priorVah - zb, border_color=color.new(priorVaCol, 55), border_width=1, bgcolor=color.new(priorVaCol, 91))
            lnPoc := line.new(x1, priorPoc, bar_index, priorPoc, color=color.new(priorPocCol, 25), style=line.style_dashed, width=1)
            bxVal := box.new(x1, priorVal + zb, bar_index, priorVal - zb, border_color=color.new(priorVaCol, 55), border_width=1, bgcolor=color.new(priorVaCol, 91))
        else
            bxVah.set_right(bar_index)
            lnPoc.set_x2(bar_index)
            bxVal.set_right(bar_index)

    // Bias letter at each interval checkpoint
    elapsed = (time - sessionStartTime) / 60000.0
    crossed = plotInterval <= 0 or math.floor(elapsed / plotInterval) > math.floor(lastCheckpointElapsed / plotInterval)

    if crossed and havePrior
        haveToday     = useQual and volumeByPrice.size() > 0
        aboveTodayPoc = haveToday and close > livePoc

        string letter = switch confirmed
            Bias.long  => not haveToday or aboveTodayPoc ? "L" : "l"      // "l" = long but today's POC lost
            Bias.short => not haveToday or not aboveTodayPoc ? "S" : "s"  // "s" = short but today's POC reclaimed
            => "N"

        isFlip = confirmed != lastPrinted
        color col = switch confirmed
            Bias.long  => isFlip ? flipLongCol : contLongCol
            Bias.short => isFlip ? flipShortCol : contShortCol
            => isFlip ? flipNeutralCol : contNeutralCol

        letterLbls.push(label.new(bar_index, low - letterOffset * syminfo.mintick, letter, yloc=yloc.price, style=label.style_none, textcolor=col, size=letterSize))
        letterBars.push(bar_index)
        lastPrinted := confirmed
    lastCheckpointElapsed := elapsed

    // Drop letters older than the keep window
    if letterKeepBars > 0
        while letterBars.size() > 0 and bar_index - letterBars.first() >= letterKeepBars
            label.delete(letterLbls.shift())
            letterBars.shift()
    pruneLbls(faLbls, faBars, faKeepBars)
    pruneLns(faLns, faLnBars, faKeepBars)
    pruneLbls(bubLbls, bubBars, bubbleKeepBars)

alertcondition(sigShort, "Failed Breakout -> Short to Prior VAL", "Failed breakout above prior VAH: short, target prior VAL")
alertcondition(sigLong,  "Failed Breakdown -> Long to Prior VAH", "Failed breakdown below prior VAL: long, target prior VAH")

// ── Today's developing levels ───────────────────────────
showFull = liveMode == "Full History"
plot(showFull ? liveVah : na, "Today VAH", color=liveVahCol, linewidth=2)
plot(showFull ? livePoc : na, "Today POC", color=livePocCol, linewidth=2)
plot(showFull ? liveVal : na, "Today VAL", color=liveValCol, linewidth=2)

// Stubs + tags live only on the last bar, so they're created once and moved.
var line  stVah = line.new(0, float(na), 0, float(na), color=liveVahCol, width=1)
var line  stPoc = line.new(0, float(na), 0, float(na), color=livePocCol, width=1)
var line  stVal = line.new(0, float(na), 0, float(na), color=liveValCol, width=1)
var label tgVah = label.new(0, float(na), "", style=label.style_label_left, color=color.new(liveVahCol, 85), textcolor=liveVahCol, size=noteSz)
var label tgPoc = label.new(0, float(na), "", style=label.style_label_left, color=color.new(livePocCol, 85), textcolor=livePocCol, size=noteSz)
var label tgVal = label.new(0, float(na), "", style=label.style_label_left, color=color.new(liveValCol, 85), textcolor=liveValCol, size=noteSz)
var label tgPVah = label.new(0, float(na), "", style=label.style_label_left, color=color.new(priorVaCol, 85), textcolor=priorVaCol, size=noteSz)
var label tgPPoc = label.new(0, float(na), "", style=label.style_label_left, color=color.new(priorPocCol, 85), textcolor=priorPocCol, size=noteSz)
var label tgPVal = label.new(0, float(na), "", style=label.style_label_left, color=color.new(priorVaCol, 85), textcolor=priorVaCol, size=noteSz)

// Show a stub/tag at (x1..x2, y) with text, or hide it when y is na / disabled.
setStub(line ln, float y, bool on, int x1, int x2) =>
    ln.set_xy1(x1, on ? y : na)
    ln.set_xy2(x2, on ? y : na)
// Today's tags sit next to the stubs; prior tags go one column further right so
// close levels (e.g. VAH vs Prior VAH) don't overlap.
setTag(label lb, float y, string txt, bool on, int xOff) =>
    lb.set_xy(bar_index + xOff, on and not na(y) ? y : na)
    lb.set_text(txt + " " + str.tostring(y, format.mintick))

if barstate.islast
    liveOn = liveMode != "Off"
    stubOn = liveMode == "Stubs"
    x1 = bar_index - stubBars + 1
    setStub(stVah, liveVah, stubOn, x1, bar_index + 2)
    setStub(stPoc, livePoc, stubOn, x1, bar_index + 2)
    setStub(stVal, liveVal, stubOn, x1, bar_index + 2)
    setTag(tgVah, liveVah, "VAH", showTags and liveOn, 3)
    setTag(tgPoc, livePoc, "POC", showTags and liveOn, 3)
    setTag(tgVal, liveVal, "VAL", showTags and liveOn, 3)
    priorOn = showTags and showRef and havePrior
    setTag(tgPVah, priorVah, "pVAH", priorOn, 18)
    setTag(tgPPoc, priorPoc, "pPOC", priorOn, 18)
    setTag(tgPVal, priorVal, "pVAL", priorOn, 18)

// ── Readout strip: [Bias] [Prior VAH] [Prior POC] [Prior VAL] in one row ──
fmt(float v) => na(v) ? "—" : str.tostring(v, format.mintick)

readoutPosition = switch readoutPos
    "Top Left"      => position.top_left
    "Middle Left"   => position.middle_left
    "Middle Right"  => position.middle_right
    "Top Center"    => position.top_center
    "Bottom Left"   => position.bottom_left
    "Bottom Center" => position.bottom_center
    "Bottom Right"  => position.bottom_right
    => position.top_right
readoutSize = readoutSizeIn == "Small" ? size.small : readoutSizeIn == "Large" ? size.large : size.normal
readoutTop  = str.startswith(readoutPos, "Top")

// Two rows: an empty spacer row on the pane-edge side, then the strip itself.
panelBg  = color.new(#161A22, 8)
panelFg  = #E6E8EB
var table readout = table.new(readoutPosition, 4, 3, frame_color=color.new(#2A2E39, 0), frame_width=1, border_color=color.new(#2A2E39, 0), border_width=1)
if showReadout and barstate.islast
    haveToday = useQual and volumeByPrice.size() > 0
    aboveTodayPoc = haveToday and close > livePoc
    [biasTxt, biasBg, biasFg] = switch confirmed
        Bias.long  => [not haveToday or aboveTodayPoc ? "Bias L" : "Bias l", flipLongCol, color.black]
        Bias.short => [not haveToday or not aboveTodayPoc ? "Bias S" : "Bias s", flipShortCol, color.black]
        => ["Bias N", #8B919A, color.black]
    spacerRow = readoutTop ? 0 : 2
    stripRow  = 1
    dirRow    = readoutTop ? 2 : 0
    if readoutOffset > 0
        readout.cell(0, spacerRow, "", height=readoutOffset)
    readout.cell(0, stripRow, havePrior ? biasTxt : "Bias —", bgcolor=havePrior ? color.new(biasBg, 10) : color.new(color.gray, 20), text_color=havePrior ? #0B0E11 : panelFg, text_size=readoutSize)
    readout.cell(1, stripRow, "VAH " + fmt(priorVah), bgcolor=panelBg, text_color=priorVaCol, text_size=readoutSize)
    readout.cell(2, stripRow, "POC " + fmt(priorPoc), bgcolor=panelBg, text_color=priorPocCol, text_size=readoutSize)
    readout.cell(3, stripRow, "VAL " + fmt(priorVal), bgcolor=panelBg, text_color=priorVaCol, text_size=readoutSize)

    // Direction line: what to do at the prior-session levels right now
    if faShowDir and showFA
        string dirTxt = "Waiting for prior session"
        color  dirAcc = #8B919A
        if havePrior
            if rotDir == -1
                dirTxt := "SHORT ▸ Prior VAL " + fmt(priorVal) + "\nFailed breakout of VAH"
                dirAcc := failBoCol
            else if rotDir == 1
                dirTxt := "LONG ▸ Prior VAH " + fmt(priorVah) + "\nFailed breakdown of VAL"
                dirAcc := failBdCol
            else if confirmed == Bias.long
                dirTxt := "Accepted above VAH\nNo fade · VAH is support"
                dirAcc := succBoCol
            else if confirmed == Bias.short
                dirTxt := "Accepted below VAL\nNo fade · VAL is resistance"
                dirAcc := succBdCol
            else if close > priorVah
                dirTxt := "Above VAH\nFail back inside → short to VAL"
                dirAcc := #F5C451
            else if close < priorVal
                dirTxt := "Below VAL\nFail back inside → long to VAH"
                dirAcc := #F5C451
            else
                dirTxt := "Inside value\nFade VAH → VAL · VAL → VAH"
        readout.cell(0, dirRow, dirTxt, bgcolor=color.new(dirAcc, 82), text_color=panelFg, text_size=readoutSize)
        readout.merge_cells(0, dirRow, 3, dirRow)
