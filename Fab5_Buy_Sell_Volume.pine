// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Original © ceyhun — this version adds 1-minute sub-bar aggregation + a configurable rolling window
//@version=6
indicator("Fab5 Buy Sell Volume", format=format.volume, precision=0, overlay=false)

// Buy/sell volume is still an estimate from close-location-within-range (no real bid/ask
// aggressor data). Aggregating from 1-minute sub-bars reduces — but does not eliminate —
// the information loss from only looking at the parent bar's own open/high/low/close.

// ————— Inputs —————
lookback             = input.int(8, "Buy/Sell % Window (bars)", minval=1,
     tooltip="Rolling sum window, in CHART bars, for the Buy/Sell % readout.")
useLowerTF           = input.bool(true, "Aggregate from 1-minute sub-bars",
     tooltip="When on and the chart timeframe is above 1 minute, each bar's buy/sell volume is computed from its underlying 1-minute bars and summed, instead of from the bar's own OHLC. Falls back to the bar's own OHLC on a 1-minute chart or lower.")
barColorsOnPrevClose = input.bool(false, "Color bars based on previous close")
Barcolor             = input.bool(false, "Buy Sell Volume Barcolor")
vi                   = input.bool(false, "Volume Index")
VNBarcolor           = input.bool(false, "Volume Index Barcolor")
Vnlen                = input.int(1, "Volume Index length", minval=1)

// ————— 1-minute sub-bar aggregation —————
canUseLowerTF = timeframe.in_seconds(timeframe.period) > 60

[loH, loL, loC, loV] = request.security_lower_tf(
     syminfo.tickerid, "1", [high, low, close, volume], ignore_invalid_timeframe = true)

subBarBV(subH, subL, subC, subV) =>
    r = subH - subL
    r > 0 ? subV * (subC - subL) / r : subV * 0.5

sumSubBars() =>
    float bv = 0.0
    float sv = 0.0
    if not na(loC) and array.size(loC) > 0
        for i = 0 to array.size(loC) - 1
            bvi = subBarBV(array.get(loH, i), array.get(loL, i), array.get(loC, i), array.get(loV, i))
            bv += bvi
            sv += array.get(loV, i) - bvi
    [bv, sv]

[subBV, subSV] = sumSubBars()

// ————— Per-bar buy/sell volume: own OHLC, or 1m-aggregated —————
ownBV = high == low ? volume * 0.5 : volume * (close - low) / (high - low)
ownSV = volume - ownBV

useSub = useLowerTF and canUseLowerTF and not na(subBV) and (subBV + subSV) > 0

BV  = useSub ? subBV : ownBV
SV  = useSub ? subSV : ownSV
vol = volume > 0 ? volume : 1

// ————— Rolling window (replaces the old single-bar %) —————
BVsum = math.sum(BV, lookback)
SVsum = math.sum(SV, lookback)

BuyVolumePercent  = (BVsum + SVsum) > 0 ? 100 * BVsum / (BVsum + SVsum) : 50
SellVolumePercent = 100 - BuyVolumePercent

// ————— Legacy single-bar normalized pressure (Karthik Marar XeL-MOD) —————
VN  = vol / ta.ema(vol, 20)
BPN = BV / ta.ema(BV, 20) * VN * 100
SPN = SV / ta.ema(SV, 20) * VN * 100

BPc1 = BV > SV ? BV : -math.abs(BV)
BPc2 = BPN > SPN ? BPN : -math.abs(BPN)
SPc1 = SV > BV ? SV : -math.abs(SV)
SPc2 = SPN > BPN ? SPN : -math.abs(SPN)
BPcon = vi ? BPc2 : BPc1
SPcon = vi ? SPc2 : SPc1

// ————— Plots —————
palette = barColorsOnPrevClose ?
     (close[1] > close ? color.new(color.red, 70) : color.new(color.green, 70)) :
     (open > close ? color.new(color.red, 70) : color.new(color.green, 70))
plot(vi ? na : volume, title="Volume", color=palette, style=plot.style_columns, linewidth=3)

plot(vi ? na : BPcon, title="BuyVolume", color=color.new(color.green, 10), style=plot.style_columns)
plot(vi ? na : SPcon, title="SellVolume", color=color.new(color.red, 10), style=plot.style_columns)

colors = BPcon > SPcon ? color.blue : BPcon < SPcon ? color.purple : color.gray
barcolor(Barcolor ? colors : na)

plot(vi ? na : BuyVolumePercent, title="BuyVolume% (windowed)", color=color.green, style=plot.style_circles)
plot(vi ? na : SellVolumePercent, title="SellVolume% (windowed)", color=color.red, style=plot.style_circles)

VNcolors = VN > Vnlen and close > open ? #00ffff :
     VN > Vnlen and close < open ? color.new(color.gray, 10) : color.new(color.yellow, 10)
plot(VN, title="VolumeIndex", color=VNcolors, style=plot.style_columns)
barcolor(VNBarcolor ? VNcolors : na)

// ————— Multi-timeframe Buy% strip (1m/5m/15m/30m/1h) —————
// Only meaningful -- and only accurate -- on a native 1-minute chart. Every attempt to
// reconstruct 1-minute-equivalent data on a coarser chart (local intrabar accumulation
// via request.security_lower_tf, or a raw request.security call for a lower timeframe,
// which Pine's own docs warn against) showed real drift between panes of different chart
// resolutions -- a structural fact about how Pine scripts execute relative to their host
// chart, not something a cleverer formula fixes. So: no reconstruction. math.sum() over
// the chart's own bars is 100% deterministic on a 1-minute chart. On anything coarser,
// this shows a warning instead of a silently-wrong number.

showMTFStrip = input.bool(true, "Show Multi-Timeframe Buy% Strip", group="Multi-TF Strip")
mtfThreshold = input.float(52.0, "Buy/Sell Dominance Threshold %", group="Multi-TF Strip")

onOneMinChart = timeframe.in_seconds(timeframe.period) == 60

f_pctOverN(n) =>
    sumBV = math.sum(ownBV, n)
    sumSV = math.sum(ownSV, n)
    sumBV + sumSV > 0 ? 100 * sumBV / (sumBV + sumSV) : 50.0

pct1  = f_pctOverN(1)
pct5  = f_pctOverN(5)
pct15 = f_pctOverN(15)
pct30 = f_pctOverN(30)
pct60 = f_pctOverN(60)

mtfCellColor(p) =>
    p >= mtfThreshold ? color.new(color.green, 20) : p <= (100 - mtfThreshold) ? color.new(color.red, 20) : color.new(color.gray, 20)

var table mtfTable = table.new(position.top_right, 6, 1, border_width=1)

if showMTFStrip and barstate.islast
    if not onOneMinChart
        table.cell(mtfTable, 0, 0, "⚠ Multi-TF strip needs a 1-minute chart", bgcolor=color.new(color.orange, 20), text_color=color.white)
    else
        table.cell(mtfTable, 0, 0, "", bgcolor=color.new(color.black, 100))
        table.cell(mtfTable, 1, 0, "1m " + str.tostring(math.round(pct1)) + "%",   bgcolor=mtfCellColor(pct1),  text_color=color.white)
        table.cell(mtfTable, 2, 0, "5m " + str.tostring(math.round(pct5)) + "%",   bgcolor=mtfCellColor(pct5),  text_color=color.white)
        table.cell(mtfTable, 3, 0, "15m " + str.tostring(math.round(pct15)) + "%", bgcolor=mtfCellColor(pct15), text_color=color.white)
        table.cell(mtfTable, 4, 0, "30m " + str.tostring(math.round(pct30)) + "%", bgcolor=mtfCellColor(pct30), text_color=color.white)
        table.cell(mtfTable, 5, 0, "1h " + str.tostring(math.round(pct60)) + "%",  bgcolor=mtfCellColor(pct60), text_color=color.white)
