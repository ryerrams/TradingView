//@version=6
// LASOMA: Signals & Overlays Visual
// Pine Script v6 conversion of the ThinkScript port of TXInvestor's "LASOMA: Signals & Overlays Visual".
// Ports: preset system, Smart Trail, Trend Catcher, Trend Tracer, Neo Cloud, VWAP / anchored VWAP,
// opening range, structure (BOS/CHoCH), liquidity sweeps, FVG, order blocks, HTF levels, futures
// regime/flow model, ML-style ensemble score, trade levels, regime/strength/squeeze/volume labels, alerts.
// Notes:
// - Pine boxes are native here (unlike the ThinkScript port), so FVG / order blocks are drawn as real
//   boxes with a max-count cap rather than a single "latest zone" approximation.
// - The KNN filter from the original Pine source is intentionally NOT reproduced (ml.knn / matrix based
//   loops are out of scope for a faithful, maintainable port); UseKnnFilter is kept as a pass-through
//   toggle that only shows a warning label, exactly like the ThinkScript version.
// - DYNAMIC build (synced to the ThinkScript "Scalping Dynamic build" of 2026-09-29, mirrors the
//   paper-v4 bot on the same signal engine):
//     * a 2/5 signal is accepted when the close is within Conf2NearTrailAtr of the Smart Trail
//     * a signal further than ChaseAtr from the trail is not chased: a retest level (trail +/- RetestAtr)
//       is drawn for RetestBars bars, cancelled on a trend flip, "RETEST" on the first touch
//     * a climax-volume signal bar (volume z > ClimaxVolumeZ) is shown grey (bot vetoes it)
//     * two status rows (last closed bar's signal + bot decision, and the LONG/SHORT ZONE verdict)
//     * the TOS scan drop-down is a hidden "Scan" plot (Pine Screener column) + alert condition
//   Engine parameters (ATR(5) in Scalping, trail x2.0, sensitivity 12) are unchanged: chart == bot.
indicator("LASOMA: Signals & Overlays Visual", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 2000)

// ============================================================================================
// INPUTS
// ============================================================================================
TradingPreset       = input.string("Screener Match", "Trading Preset", options = ["Screener Match", "Scalping", "Day Trading", "Trend Trading", "Swing Trading", "Futures", "Custom"], group = "Presets")
VisualPreset        = input.string("None", "Visual Preset", options = ["None", "Smart Trail", "Trend Catcher", "Trend Tracer", "Neo Cloud", "All", "Custom"], group = "Presets")
SignalModeOverride  = input.string("Preset Default", "Signal Mode Override", options = ["Preset Default", "Component Score", "Trend Catcher", "Trend Investor"], group = "Presets")
SignalSensitivity   = input.int(24, "Signal Sensitivity", group = "Presets")
ShowSignalMarkers   = input.bool(true, "Show Signal Markers", group = "Presets")
EnableAlerts        = input.bool(false, "Enable Alerts", group = "Presets")

UseKnnFilter          = input.bool(false, "Use KNN Filter (pass-through, not reproduced)", group = "KNN (unused)")
KnnLookback            = input.int(50, "KNN Lookback", group = "KNN (unused)")
KnnNeighbors           = input.int(8, "KNN Neighbors", group = "KNN (unused)")
KnnDistanceThreshold   = input.float(10.0, "KNN Distance Threshold", group = "KNN (unused)")

CustomSmartTrail   = input.bool(false, "Custom: Smart Trail", group = "Custom Visual Toggles")
CustomCatcher      = input.bool(false, "Custom: Trend Catcher", group = "Custom Visual Toggles")
CustomTracer       = input.bool(false, "Custom: Trend Tracer", group = "Custom Visual Toggles")
CustomCloud        = input.bool(false, "Custom: Neo Cloud", group = "Custom Visual Toggles")
ShowTrendOverlayInput = input.bool(false, "Custom: Trend Overlay (squares/bar color)", group = "Custom Visual Toggles")
CustomMlScore      = input.bool(false, "Custom: ML Score Label", group = "Custom Visual Toggles")

ShowVwap            = input.bool(false, "Show Session VWAP", group = "Levels & Zones")
ShowAnchoredVwap     = input.bool(false, "Show Anchored VWAP (from last pivot)", group = "Levels & Zones")
ShowOpeningRange     = input.bool(false, "Show Opening Range", group = "Levels & Zones")
ShowStructure        = input.bool(false, "Show Structure (BOS/CHoCH)", group = "Levels & Zones")
ShowLiquidity        = input.bool(false, "Show Liquidity Sweeps", group = "Levels & Zones")
ShowFvg              = input.bool(false, "Show Fair Value Gaps", group = "Levels & Zones")
ShowOrderBlocks      = input.bool(false, "Show Order Blocks", group = "Levels & Zones")
ShowBreakers         = input.bool(false, "Show Breaker Blocks", group = "Levels & Zones")
ShowHtfLevels        = input.bool(false, "Show HTF Prior High/Low", group = "Levels & Zones")
ShowRegime           = input.bool(false, "Show Regime Label", group = "Levels & Zones")

OpeningRangeStartTime = input.string("0930", "Opening Range Start (HHMM, exchange time)", group = "Sessions/Structure")
OpeningRangeEndTime   = input.string("1000", "Opening Range End (HHMM, exchange time)", group = "Sessions/Structure")
VwapSessionStartTime  = input.string("0930", "VWAP Session Start (HHMM, exchange time)", group = "Sessions/Structure")
VwapSessionEndTime    = input.string("1600", "VWAP Session End (HHMM, exchange time)", group = "Sessions/Structure")
StructurePivotLength = input.int(5, "Structure Pivot Length", group = "Sessions/Structure")
LiquidityLookback    = input.int(20, "Liquidity Lookback", group = "Sessions/Structure")
HtfAggregation       = input.timeframe("D", "HTF Aggregation", group = "Sessions/Structure")

ShowMlLabel                     = input.bool(true, "Show ML Score Label", group = "ML / Scoring")
MlSensitivity                   = input.float(1.8, "ML Sensitivity", group = "ML / Scoring")
MlBullThreshold                 = input.float(60.0, "ML Bull Threshold", group = "ML / Scoring")
MlBearThreshold                 = input.float(40.0, "ML Bear Threshold", group = "ML / Scoring")
MinMlConfidence                 = input.int(3, "Minimum ML Confidence (1-5)", group = "ML / Scoring")
EnableScalpingScoreChangeSignals = input.bool(true, "Enable Scalping Score-Change Signals", group = "ML / Scoring")
ShowModelScoreHistory            = input.bool(true, "Plot Model Score History (hidden)", group = "ML / Scoring")

// ---- DYNAMIC (paper-v4) inputs ----
Conf2NearTrailAtr     = input.float(1.0, "Conf 2 Near-Trail ATR", tooltip = "Accept a 2/5 signal when the close is within this many ATR of the Smart Trail", group = "Dynamic (paper-v4)")
ChaseAtr              = input.float(2.0, "Chase ATR", tooltip = "A signal further than this from the trail is NOT chased -> wait for the retest", group = "Dynamic (paper-v4)")
RetestAtr             = input.float(1.4, "Retest ATR", tooltip = "Retest level = trail +/- this many ATR", group = "Dynamic (paper-v4)")
RetestBars            = input.int(12, "Retest Bars", tooltip = "The retest order lives this many bars", group = "Dynamic (paper-v4)")
ClimaxVolumeZ         = input.float(1.0, "Climax Volume Z", tooltip = "Signal-bar volume z-score above this = climax bar (bot vetoes)", group = "Dynamic (paper-v4)")
ShowDynamicLabel      = input.bool(true, "Show Zone Label", group = "Dynamic (paper-v4)")
ShowConfidenceBubbles = input.bool(true, "Show Confidence Bubbles", tooltip = "GREEN = bot takes the long, RED = bot takes the short, GREY = signal only", group = "Dynamic (paper-v4)")
ShowDecisionBubbles   = input.bool(false, "Show Decision Bubbles", tooltip = "Verbose \"conf | ATR wait/CLX\" bubbles instead of the plain confidence number", group = "Dynamic (paper-v4)")
ShowEntryArrows       = input.bool(false, "Show Entry Arrows", tooltip = "Arrows on the bars the bot enters (retest fills included)", group = "Dynamic (paper-v4)")
BubbleCooldownBars    = input.int(0, "Bubble Cooldown Bars", tooltip = "Same verdict on consecutive bars prints once every N bars (score-change signals repeat)", group = "Dynamic (paper-v4)")
ShowSignalLabel       = input.bool(true, "Show Signal Label", tooltip = "What the last CLOSED bar's signal was and what the bot did with it", group = "Dynamic (paper-v4)")

AtrLength                    = input.int(14, "ATR Length", group = "Core Engine")
TrailMultiplier               = input.float(3.0, "Trail ATR Multiplier", group = "Core Engine")
CatcherFastEma                = input.int(8, "Catcher Fast EMA", group = "Core Engine")
CatcherSlowEma                 = input.int(21, "Catcher Slow EMA", group = "Core Engine")
TracerLength                   = input.int(24, "Tracer (Inertia) Length", group = "Core Engine")
CloudLength                    = input.int(50, "Cloud Basis Length", group = "Core Engine")
CloudAtrWidth                  = input.float(1.5, "Cloud ATR Width", group = "Core Engine")
CloudRangeLength                = input.int(80, "Cloud Range Length", group = "Core Engine")
FuturesConfirmationBars         = input.int(1, "Futures Confirmation Bars (unused, kept for parity)", group = "Core Engine")
FuturesTrendStrengthFilter      = input.bool(true, "Futures Trend Strength Filter (ADX)", group = "Core Engine")
FuturesMinimumAdx               = input.float(18.0, "Futures Minimum ADX", group = "Core Engine")
FuturesStructureLookback        = input.int(10, "Futures Structure Lookback", group = "Core Engine")
FuturesImpulseAtrThreshold      = input.float(0.75, "Futures Impulse ATR Threshold", group = "Core Engine")

ShowCloudFill         = input.bool(true, "Show Cloud Fill", group = "Style")
ShowCloudInnerRibbon   = input.bool(false, "Show Cloud Inner Ribbon", group = "Style")
KeepCloudBelowPrice    = input.bool(true, "Keep Cloud Below Price", group = "Style")
ShowTrailFill          = input.bool(true, "Show Trail Fill", group = "Style")
ShowCatcherFill        = input.bool(true, "Show Catcher Fill", group = "Style")
ShowCatcherBoundaries  = input.bool(false, "Show Catcher Boundaries", group = "Style")
ShowCatcherCenterLine  = input.bool(true, "Show Catcher Center Line", group = "Style")
CatcherStyle           = input.string("Smooth", "Catcher Style", options = ["Smooth", "Stepped"], group = "Style")
CatcherSmoothing       = input.int(3, "Catcher Smoothing", group = "Style")
TrailStyle             = input.string("Line", "Trail Style", options = ["Line", "Stepped"], group = "Style")
TrailSmoothing         = input.int(3, "Trail Smoothing", group = "Style")
TrailBandAtrWidth      = input.float(0.35, "Trail Band ATR Width", group = "Style")
ShowLevels             = input.bool(false, "Show Trade Levels", group = "Style")
StopAtrMultiplier      = input.float(1.5, "Stop ATR Multiplier", group = "Style")
Target1R               = input.float(1.0, "Target 1 (R)", group = "Style")
Target2R               = input.float(2.0, "Target 2 (R)", group = "Style")
Target3R               = input.float(3.0, "Target 3 (R)", group = "Style")
Stop1R                 = input.float(1.0, "Stop 1 (R)", group = "Style")
Stop2R                 = input.float(1.5, "Stop 2 (R)", group = "Style")

ShowStrength         = input.bool(false, "Show Strength Label", group = "Labels")
ShowSqueeze          = input.bool(false, "Show Squeeze Label", group = "Labels")
ShowVolumeSentiment  = input.bool(false, "Show Volume Sentiment Label", group = "Labels")

// ============================================================================================
// COLORS  (DefineGlobalColor equivalents)
// ============================================================================================
colBull      = color.new(color.rgb(34, 197, 94), 0)
colBear      = color.new(color.rgb(255, 32, 32), 0)
colNeutral   = color.new(color.rgb(139, 92, 246), 0)
colChochBar  = color.new(color.rgb(180, 140, 255), 0)
colBullChoch = color.new(color.rgb(34, 197, 94), 0)
colBearChoch = color.new(color.rgb(255, 32, 32), 0)
colTrailBull = color.new(color.rgb(0, 188, 212), 0)
colTrailBear = color.new(color.rgb(255, 152, 0), 0)
colNeoCloud  = color.new(color.rgb(91, 156, 246), 0)
colNeoFill   = color.new(color.rgb(16, 39, 93), 0)
colStop      = color.new(color.rgb(242, 54, 69), 0)
colTarget    = color.new(color.rgb(41, 98, 255), 0)
colEntry     = color.new(color.rgb(120, 123, 134), 0)
colGrey      = color.rgb(128, 128, 128)   // TOS Color.GRAY

// ============================================================================================
// HELPER FUNCTIONS  (script Clamp / ConfidenceLevel)
// ============================================================================================
f_clamp(_value) =>
    math.max(-1.0, math.min(1.0, _value))

f_confidenceLevel(_score) =>
    _distance = math.abs(_score - 50.0) * 2.0
    _distance >= 80.0 ? 5 : _distance >= 60.0 ? 4 : _distance >= 30.0 ? 3 : _distance >= 10.0 ? 2 : 1

// TOS built-in Inertia(price, length): linear regression (over `length`) of a 10/14 Relative
// Vigor Index. Reproduced here since Pine has no native Inertia() function.
f_inertia(_src, _length) =>
    _stdev   = ta.stdev(_src, 10)
    _upDev   = _src > _src[1] ? _stdev : 0.0
    _downDev = _src < _src[1] ? _stdev : 0.0
    _num     = ta.sma(_upDev, 14)
    _den     = _num + ta.sma(_downDev, 14)
    _rvi     = _den != 0 ? _num / _den * 100.0 : 50.0
    ta.linreg(_rvi, _length, 0)

// ============================================================================================
// CORE STATE
// ============================================================================================
tick = syminfo.mintick
hlc3v = hlc3

manualVisualEnabled = TradingPreset == "Futures" or CustomSmartTrail or CustomCatcher or CustomTracer or CustomCloud or
                       ShowSignalMarkers or CustomMlScore or ShowVwap or ShowAnchoredVwap or ShowOpeningRange or
                       ShowStructure or ShowLiquidity or ShowFvg or ShowOrderBlocks or ShowBreakers or ShowHtfLevels or
                       ShowRegime or ShowLevels or ShowStrength or ShowSqueeze or ShowVolumeSentiment
visualEnabled = VisualPreset != "None" or manualVisualEnabled

showSmartTrail = visualEnabled and (CustomSmartTrail or VisualPreset == "Smart Trail" or VisualPreset == "All")
showCatcher    = visualEnabled and (CustomCatcher or VisualPreset == "Trend Catcher" or VisualPreset == "All")
showTracer     = visualEnabled and (CustomTracer or VisualPreset == "Trend Tracer" or VisualPreset == "All")
showCloud      = visualEnabled and (CustomCloud or VisualPreset == "Neo Cloud" or VisualPreset == "All")
// Deviation from the original ThinkScript default (which auto-enabled this for nearly every
// preset): bar coloring dominated by "neutral" purple whenever the active signal mode requires
// full agreement across sub-indicators, which reads as worse than plain up/down candle colors.
// Made strictly opt-in per user preference.
showTrendOverlay = ShowTrendOverlayInput
showSignals    = visualEnabled and ShowSignalMarkers
showMlScore    = visualEnabled and CustomMlScore

activeAtrLength = TradingPreset == "Screener Match" ? 14 : TradingPreset == "Scalping" ? 5 : TradingPreset == "Day Trading" ? 10 : TradingPreset == "Futures" ? 10 : AtrLength
activeCatcherFast = TradingPreset == "Scalping" ? 5 : TradingPreset == "Trend Trading" ? 10 : TradingPreset == "Swing Trading" ? 13 : CatcherFastEma
activeCatcherSlow = TradingPreset == "Scalping" ? 13 : TradingPreset == "Trend Trading" ? 30 : TradingPreset == "Swing Trading" ? 34 : CatcherSlowEma
activeTracerLength = TradingPreset == "Scalping" ? 14 : TradingPreset == "Trend Trading" ? 34 : TradingPreset == "Swing Trading" ? 50 : TracerLength
activeCloudLength = TradingPreset == "Scalping" ? 34 : TradingPreset == "Trend Trading" ? 70 : TradingPreset == "Swing Trading" ? 100 : CloudLength
activeCloudRangeLength = TradingPreset == "Scalping" ? 40 : TradingPreset == "Futures" ? 60 : TradingPreset == "Trend Trading" ? 110 : TradingPreset == "Swing Trading" ? 140 : CloudRangeLength
activeCloudWidth = TradingPreset == "Scalping" ? 1.0 : TradingPreset == "Futures" ? 1.8 : TradingPreset == "Trend Trading" ? 1.7 : TradingPreset == "Swing Trading" ? 2.0 : CloudAtrWidth
activeTrailMultiplier = TradingPreset == "Scalping" ? 2.0 : TradingPreset == "Day Trading" ? 2.5 : TradingPreset == "Swing Trading" ? 3.5 : TradingPreset == "Futures" ? 2.0 : TrailMultiplier
activeSignalSensitivity = TradingPreset == "Scalping" ? 12 : TradingPreset == "Day Trading" ? 16 : TradingPreset == "Trend Trading" ? 20 : TradingPreset == "Futures" ? 12 : SignalSensitivity

presetSignalModeComponent = TradingPreset == "Screener Match" or TradingPreset == "Custom"
presetSignalModeCatcher   = TradingPreset == "Day Trading"
useComponentSignalMode = SignalModeOverride == "Component Score" or (SignalModeOverride == "Preset Default" and presetSignalModeComponent)
useCatcherSignalMode   = SignalModeOverride == "Trend Catcher" or (SignalModeOverride == "Preset Default" and presetSignalModeCatcher)
useInvestorSignalMode  = SignalModeOverride == "Trend Investor" or (SignalModeOverride == "Preset Default" and not presetSignalModeComponent and not presetSignalModeCatcher)

// ============================================================================================
// CORE INDICATORS
// ============================================================================================
trv = ta.tr(true)
atrValue = ta.rma(trv, activeAtrLength)
atrAverage = ta.sma(atrValue, 50)
atrSafe = math.max(atrValue, tick)

emaFast = ta.ema(close, activeCatcherFast)
emaSlow = ta.ema(close, activeCatcherSlow)
catcherVisualFast = ta.ema(emaFast, CatcherSmoothing)
catcherVisualSlow = ta.ema(emaSlow, CatcherSmoothing)
catcherVisualUpper = math.max(catcherVisualFast, catcherVisualSlow)
catcherVisualLower = math.min(catcherVisualFast, catcherVisualSlow)
catcherVisualCenter = (catcherVisualUpper + catcherVisualLower) * 0.5
catcherBullish = emaFast > emaSlow
catcherLongSignal  = ta.crossover(emaFast, emaSlow)
catcherShortSignal = ta.crossunder(emaFast, emaSlow)

tracerValue = f_inertia(close, activeTracerLength)
tracerBullish = tracerValue > tracerValue[1]

cloudBasis = ta.sma(close, activeCloudLength)
cloudWidth = atrValue * activeCloudWidth
cloudUpper = cloudBasis + cloudWidth
cloudLower = cloudBasis - cloudWidth
rawCloudOuterUpper = ta.highest(high, activeCloudRangeLength)
rawCloudOuterLower = ta.lowest(low, activeCloudRangeLength)
supportCloudUpper = ta.highest(low, activeCloudRangeLength)
cloudOuterUpper = KeepCloudBelowPrice ? math.min(supportCloudUpper, close - atrValue * 0.25) : rawCloudOuterUpper
cloudOuterLower = KeepCloudBelowPrice ? math.min(rawCloudOuterLower, cloudOuterUpper - atrValue * 2.0) : rawCloudOuterLower
visualCloudUpper = KeepCloudBelowPrice ? math.min(cloudUpper, close - atrValue * 0.25) : cloudUpper
visualCloudBasis = KeepCloudBelowPrice ? math.min(cloudBasis, visualCloudUpper) : cloudBasis
visualCloudLower = KeepCloudBelowPrice ? math.min(cloudLower, visualCloudBasis - atrValue * 0.1) : cloudLower
cloudBullish = close > cloudBasis

rsiValue = ta.rsi(close, 14)
stDev20 = ta.stdev(close, 20)
sma20 = ta.sma(close, 20)
volumeAverage = ta.sma(volume, 20)
volumeSafe = math.max(volumeAverage, 1.0)
volumeRangeSafe = math.max(high - low, tick)
volumeSentimentNumerator = math.sum((close - low) / volumeRangeSafe * volume, 20)
volumeSentimentDenominator = math.sum(volume, 20)
strengthValue = rsiValue
squeezeValue = math.min(100.0, (stDev20 * 2.0) / (sma20 == 0 ? 1.0 : sma20) * 100.0 * 5.0)
volumeSentimentValue = (volumeSentimentDenominator == 0 ? 0.0 : volumeSentimentNumerator / volumeSentimentDenominator) * 100.0
relativeVolumeValue = volumeAverage == 0 ? 0.0 : volume / volumeAverage
volatilityRegimeValue = atrAverage == 0 ? 1.0 : atrValue / atrAverage

// ============================================================================================
// SESSIONS: VWAP / OPENING RANGE  (SecondsFromTime/SecondsTillTime -> time(tf, "start-end") idiom)
// ============================================================================================
orSessionString   = OpeningRangeStartTime + "-" + OpeningRangeEndTime
vwapSessionString = VwapSessionStartTime + "-" + VwapSessionEndTime

openingRangeActive = not na(time(timeframe.period, orSessionString))
inVwapSession       = not na(time(timeframe.period, vwapSessionString))
vwapSessionStartBar = inVwapSession and not inVwapSession[1]

var float sessionVwapPV     = na
var float sessionVwapVolume = na
sessionVwapPV := vwapSessionStartBar ? hlc3v * volume : inVwapSession ? nz(sessionVwapPV[1]) + hlc3v * volume : nz(sessionVwapPV[1])
sessionVwapVolume := vwapSessionStartBar ? volume : inVwapSession ? nz(sessionVwapVolume[1]) + volume : nz(sessionVwapVolume[1])
sessionVwapValue = inVwapSession and sessionVwapVolume > 0 ? sessionVwapPV / sessionVwapVolume : na

newTradingDay = ta.change(time("D")) != 0
var float openingRangeHigh = na
var float openingRangeLow  = na
openingRangeHigh := newTradingDay ? na : openingRangeActive ? (na(openingRangeHigh[1]) ? high : math.max(openingRangeHigh[1], high)) : openingRangeHigh[1]
openingRangeLow  := newTradingDay ? na : openingRangeActive ? (na(openingRangeLow[1])  ? low  : math.min(openingRangeLow[1], low))   : openingRangeLow[1]

// ============================================================================================
// STRUCTURE: swing pivots, BOS/CHoCH, anchored VWAP, liquidity sweeps
// ============================================================================================
pivotSpan = StructurePivotLength * 2 + 1
pivotHigh = high[StructurePivotLength] == ta.highest(high, pivotSpan)
pivotLow  = low[StructurePivotLength]  == ta.lowest(low, pivotSpan)

var float lastSwingHigh = na
var float lastSwingLow  = na
lastSwingHigh := pivotHigh ? high[StructurePivotLength] : lastSwingHigh[1]
lastSwingLow  := pivotLow  ? low[StructurePivotLength]  : lastSwingLow[1]

var int swingHighBroken = 0
var int swingLowBroken  = 0
swingHighBroken := pivotHigh ? 0 : (not na(lastSwingHigh[1]) and close > lastSwingHigh[1] and close[1] <= lastSwingHigh[1]) ? 1 : swingHighBroken[1]
swingLowBroken  := pivotLow  ? 0 : (not na(lastSwingLow[1])  and close < lastSwingLow[1]  and close[1] >= lastSwingLow[1])  ? 1 : swingLowBroken[1]

var int structureBias = 0
structureBias := (not na(lastSwingHigh[1]) and swingHighBroken[1] == 0 and close > lastSwingHigh[1] and close[1] <= lastSwingHigh[1]) ? 1 : (not na(lastSwingLow[1]) and swingLowBroken[1] == 0 and close < lastSwingLow[1] and close[1] >= lastSwingLow[1]) ? -1 : structureBias[1]

bullishStructureBreak = structureBias == 1 and structureBias[1] != 1
bearishStructureBreak = structureBias == -1 and structureBias[1] != -1
bullishChoch = bullishStructureBreak and structureBias[1] == -1
bearishChoch = bearishStructureBreak and structureBias[1] == 1

newAnchor = pivotHigh or pivotLow
var float anchoredVwapPV     = na
var float anchoredVwapVolume = na
anchoredVwapPV     := newAnchor ? hlc3v * volume : nz(anchoredVwapPV[1]) + hlc3v * volume
anchoredVwapVolume := newAnchor ? volume : nz(anchoredVwapVolume[1]) + volume
anchoredVwapValue = anchoredVwapVolume != 0 ? anchoredVwapPV / anchoredVwapVolume : na

priorLiquidityHigh = ta.highest(high, LiquidityLookback)[1]
priorLiquidityLow  = ta.lowest(low, LiquidityLookback)[1]
buySideSweep  = high > priorLiquidityHigh and close < priorLiquidityHigh
sellSideSweep = low < priorLiquidityLow and close > priorLiquidityLow

// ============================================================================================
// HTF LEVELS
// ============================================================================================
previousHtfHigh = request.security(syminfo.tickerid, HtfAggregation, high[1], lookahead = barmerge.lookahead_off)
previousHtfLow  = request.security(syminfo.tickerid, HtfAggregation, low[1],  lookahead = barmerge.lookahead_off)

// ============================================================================================
// FVG / ORDER BLOCKS  (native Pine boxes, capped, replacing the single-zone TOS approximation)
// ============================================================================================
bullishFvg = low > high[2]
bearishFvg = high < low[2]
bullishOrderBlock = close > high[1] and close[1] < open[1]
bearishOrderBlock = close < low[1] and close[1] > open[1]

var box[] bullFvgBoxes = array.new_box()
var box[] bearFvgBoxes = array.new_box()
var box[] bullObBoxes  = array.new_box()
var box[] bearObBoxes  = array.new_box()
maxZoneBoxes = 20

f_pushZoneBox(_boxes, _top, _bottom, _borderColor, _fillColor) =>
    if array.size(_boxes) >= maxZoneBoxes
        box.delete(array.shift(_boxes))
    _b = box.new(bar_index - 2, _top, bar_index + 20, _bottom, border_color = _borderColor, bgcolor = _fillColor, extend = extend.none)
    array.push(_boxes, _b)
    _b

if ShowFvg and visualEnabled and bullishFvg
    f_pushZoneBox(bullFvgBoxes, low, high[2], colBull, color.new(colBull, 85))
if ShowFvg and visualEnabled and bearishFvg
    f_pushZoneBox(bearFvgBoxes, low[2], high, colBear, color.new(colBear, 85))
if ShowOrderBlocks and visualEnabled and bullishOrderBlock
    f_pushZoneBox(bullObBoxes, high[1], low[1], colBull, color.new(colBull, 85))
if ShowOrderBlocks and visualEnabled and bearishOrderBlock
    f_pushZoneBox(bearObBoxes, high[1], low[1], colBear, color.new(colBear, 85))

// Breaker blocks: an order block whose zone gets fully closed through (mitigated) in the opposite
// direction — the ThinkScript version only had a comment placeholder; this is a faithful concrete
// definition consistent with standard SMC breaker-block logic.
bullBreaker = bearishOrderBlock[1] and close > high[1]
bearBreaker = bullishOrderBlock[1] and close < low[1]
if ShowBreakers and visualEnabled and bullBreaker
    f_pushZoneBox(bullObBoxes, high[1], low[1], colTrailBull, color.new(colTrailBull, 88))
if ShowBreakers and visualEnabled and bearBreaker
    f_pushZoneBox(bearObBoxes, high[1], low[1], colTrailBear, color.new(colTrailBear, 88))

// ============================================================================================
// FUTURES FLOW / REGIME MODEL  (CMF + MFI flow score, HyperWave momentum, ADX-gated structure)
// ============================================================================================
futuresFlowVolume = na(volume) or volume <= 0 ? 1.0 : volume
futuresFlowRange = math.max(high - low, tick)
futuresMoneyFlowVolume = ((2.0 * close - high - low) / futuresFlowRange) * futuresFlowVolume
futuresCMFRaw = math.sum(futuresMoneyFlowVolume, 20) / math.max(math.sum(futuresFlowVolume, 20), 1)
futuresCMF = ta.ema(futuresCMFRaw * 100.0, 10)

positiveMF = hlc3v > hlc3v[1] ? hlc3v * futuresFlowVolume : 0.0
negativeMF = hlc3v < hlc3v[1] ? hlc3v * futuresFlowVolume : 0.0
positiveMFSum = math.sum(positiveMF, 20)
negativeMFSum = math.sum(negativeMF, 20)
futuresMFIRaw = negativeMFSum == 0 and positiveMFSum > 0 ? 100.0 : positiveMFSum == 0 and negativeMFSum > 0 ? 0.0 : positiveMFSum == 0 and negativeMFSum == 0 ? 50.0 : 100.0 - (100.0 / (1.0 + positiveMFSum / negativeMFSum))
futuresMFI = ta.ema((futuresMFIRaw - 50.0) * 2.0, 10)
futuresFlowScore = (futuresCMF + futuresMFI) / 2.0

futuresHyperMacd = ta.ema(close, 12) - ta.ema(close, 26)
futuresHyperBase = ta.sma(close, 50)
futuresHyperRaw = ta.ema(futuresHyperBase == 0 ? 0.0 : futuresHyperMacd / futuresHyperBase * 100.0, 5)
futuresHyperRange = ta.highest(math.abs(futuresHyperRaw), 100)
futuresHyperWave = futuresHyperRange == 0 ? 0.0 : futuresHyperRaw / futuresHyperRange * 100.0
futuresTrendBullish = futuresFlowScore > 0 and futuresHyperWave > 0
futuresTrendBearish = futuresFlowScore < 0 and futuresHyperWave < 0

// ============================================================================================
// SMART TRAIL
// ============================================================================================
trailHigh = ta.highest(high, 10)
trailLow  = ta.lowest(low, 10)
smartTrail = catcherBullish ? trailHigh - activeTrailMultiplier * atrValue : trailLow + activeTrailMultiplier * atrValue
trailBullish = close > smartTrail

var float visualSmartTrail = na
visualSmartTrail := catcherBullish ? math.max(nz(visualSmartTrail[1], smartTrail), close - activeTrailMultiplier * atrValue) : math.min(nz(visualSmartTrail[1], smartTrail), close + activeTrailMultiplier * atrValue)

// ============================================================================================
// COMPONENT SCORE
// ============================================================================================
componentScore = (trailBullish ? 1 : -1) + (catcherBullish ? 1 : -1) + (tracerBullish ? 1 : -1) + (cloudBullish ? 1 : -1)
componentBullish = componentScore >= 3
componentBearish = componentScore <= -3
componentBullishSignal = componentBullish and not componentBullish[1]
componentBearishSignal = componentBearish and not componentBearish[1]

// KNN loops (ml.knn / matrix-based) are not reproduced — pass-through, exactly like the ThinkScript port.
longFilterPass = true
shortFilterPass = true

// ============================================================================================
// ML-STYLE ENSEMBLE SCORE
// ============================================================================================
signalTrendFeature     = f_clamp((emaFast - emaSlow) / atrSafe)
signalMomentumFeature  = f_clamp((close - close[5]) / (atrSafe * 2.0))
signalTracerFeature    = f_clamp((tracerValue - tracerValue[1]) / atrSafe)
signalCloudFeature     = f_clamp((close - cloudBasis) / (atrSafe * 2.0))
signalRsiFeature       = f_clamp((rsiValue - 50.0) / 30.0)
signalVolumeFeature    = f_clamp((close - open) / atrSafe * (volume / volumeSafe))
signalVolatilityRatio  = atrAverage == 0 ? 1.0 : atrValue / atrAverage
signalAdaptiveWeight   = f_clamp(2.0 - signalVolatilityRatio)
signalEnsembleRaw = signalTrendFeature * 0.25 + signalMomentumFeature * 0.20 + signalTracerFeature * 0.15 +
                     signalCloudFeature * 0.15 + signalRsiFeature * 0.15 + signalVolumeFeature * 0.10
signalMlRaw = signalEnsembleRaw * MlSensitivity * (0.85 + signalAdaptiveWeight * 0.15)
signalMlScore = 100.0 / (1.0 + math.exp(-signalMlRaw))
signalMlConfidenceLevel = f_confidenceLevel(signalMlScore)
signalMlConfidencePass = signalMlConfidenceLevel >= MinMlConfidence

// ============================================================================================
// TREND INVESTOR TRAILING STOP
// ============================================================================================
investorTrailOffset = atrValue * activeTrailMultiplier * (1.0 + (activeSignalSensitivity - 12.0) / 10.0)
var float investorTrailingStop = na
investorTrailingStop := close[1] >= nz(investorTrailingStop[1], close) ? (close < nz(investorTrailingStop[1], close) ? close + investorTrailOffset : math.max(nz(investorTrailingStop[1], close), close - investorTrailOffset)) : (close > nz(investorTrailingStop[1], close) ? close - investorTrailOffset : math.min(nz(investorTrailingStop[1], close), close + investorTrailOffset))
investorTrend = close >= investorTrailingStop ? 1 : -1

componentLongCandidate  = componentBullishSignal and longFilterPass
componentShortCandidate = componentBearishSignal and shortFilterPass
investorLongCandidate   = investorTrend == 1  and investorTrend[1] == -1 and longFilterPass
investorShortCandidate  = investorTrend == -1 and investorTrend[1] == 1  and shortFilterPass
trendCatcherLongCandidate  = catcherLongSignal and longFilterPass
trendCatcherShortCandidate = catcherShortSignal and shortFilterPass

visualTrailReference   = ta.ema(visualSmartTrail, TrailSmoothing)
investorTrailReference = ta.ema(investorTrailingStop, TrailSmoothing)
futuresTrailReference = useInvestorSignalMode ? investorTrailReference : visualTrailReference
futuresTrailUpper = futuresTrailReference + atrValue * TrailBandAtrWidth
futuresTrailLower = futuresTrailReference - atrValue * TrailBandAtrWidth
// the Smart Trail the signals are measured against (moved up from the plot section; same definition)
activeTrailVisual = useInvestorSignalMode ? investorTrailReference : visualTrailReference

// ============================================================================================
// DMI / ADX
// ============================================================================================
upMove = high - high[1]
downMove = low[1] - low
plusDM  = upMove > downMove and upMove > 0 ? upMove : 0.0
minusDM = downMove > upMove and downMove > 0 ? downMove : 0.0
dmiAtr = ta.rma(trv, 14)
plusDMRma = ta.rma(plusDM, 14)
minusDMRma = ta.rma(minusDM, 14)
diPlus  = dmiAtr != 0 ? 100.0 * plusDMRma / dmiAtr : 0.0
diMinus = dmiAtr != 0 ? 100.0 * minusDMRma / dmiAtr : 0.0
dx = (diPlus + diMinus) != 0 ? 100.0 * math.abs(diPlus - diMinus) / (diPlus + diMinus) : 0.0
adxValue = ta.rma(dx, 14)

// ============================================================================================
// FUTURES REGIME
// ============================================================================================
futuresPriorHigh = ta.highest(high, FuturesStructureLookback)[1]
futuresPriorLow  = ta.lowest(low, FuturesStructureLookback)[1]
futuresQualityBull = not FuturesTrendStrengthFilter or (adxValue >= FuturesMinimumAdx and diPlus > diMinus)
futuresQualityBear = not FuturesTrendStrengthFilter or (adxValue >= FuturesMinimumAdx and diMinus > diPlus)
futuresStructureBreakBull = close > futuresPriorHigh
futuresStructureBreakBear = close < futuresPriorLow
futuresImpulseBull = close > close[1] and (close - close[1]) >= atrValue * FuturesImpulseAtrThreshold
futuresImpulseBear = close < close[1] and (close[1] - close) >= atrValue * FuturesImpulseAtrThreshold
futuresRawRegime = (close > futuresTrailUpper and futuresQualityBull and (futuresStructureBreakBull or futuresImpulseBull)) ? 1 : (close < futuresTrailLower and futuresQualityBear and (futuresStructureBreakBear or futuresImpulseBear)) ? -1 : 0

var int futuresRegime = 0
futuresRegime := futuresRegime[1] == 1 ? (futuresRawRegime == -1 ? -1 : 1) : futuresRegime[1] == -1 ? (futuresRawRegime == 1 ? 1 : -1) : futuresRawRegime

futuresTrailBullish = futuresRegime == 1
futuresTrailBearish = futuresRegime == -1
futuresBullAlignment = futuresTrailBullish and futuresTrendBullish
futuresBearAlignment = futuresTrailBearish and futuresTrendBearish
futuresBullConfirmed = futuresTrailBullish and futuresRegime[1] != 1
futuresBearConfirmed = futuresTrailBearish and futuresRegime[1] != -1

futuresTrendFeature = futuresRegime == 1 ? 1.0 : futuresRegime == -1 ? -1.0 : 0.0
futuresThreeBarFeature = f_clamp((close - close[3]) / (atrSafe * 1.5))
futuresOneBarFeature = f_clamp((close - close[1]) / atrSafe)
futuresPressureFeature = f_clamp((close - open) / atrSafe * (volume / volumeSafe))
futuresRawScore = futuresTrendFeature * 0.50 + futuresThreeBarFeature * 0.25 + futuresOneBarFeature * 0.15 + futuresPressureFeature * 0.10
futuresScore = futuresRegime == 0 ? 50.0 : 50.0 + f_clamp(futuresRawScore) * 50.0

futuresTrailLongCandidate  = TradingPreset == "Futures" and futuresBullConfirmed and futuresBullAlignment and longFilterPass
futuresTrailShortCandidate = TradingPreset == "Futures" and futuresBearConfirmed and futuresBearAlignment and shortFilterPass
activeModelScore = TradingPreset == "Futures" ? futuresScore : signalMlScore
activeModelConfidenceLevel = f_confidenceLevel(activeModelScore)
activeModelConfidencePass = activeModelConfidenceLevel >= MinMlConfidence

scalpingBullishScoreChange = TradingPreset == "Scalping" and EnableScalpingScoreChangeSignals and signalMlScore >= MlBullThreshold and (signalMlScore[1] < MlBullThreshold or signalMlConfidenceLevel != signalMlConfidenceLevel[1])
scalpingBearishScoreChange = TradingPreset == "Scalping" and EnableScalpingScoreChangeSignals and signalMlScore <= MlBearThreshold and (signalMlScore[1] > MlBearThreshold or signalMlConfidenceLevel != signalMlConfidenceLevel[1])

sharedTrendState = TradingPreset == "Futures" ? (futuresBullAlignment ? 1 : futuresBearAlignment ? -1 : 0) : useInvestorSignalMode ? investorTrend : useCatcherSignalMode ? (catcherBullish ? 1 : -1) : componentScore >= 3 ? 1 : componentScore <= -3 ? -1 : 0
sharedTrendBullish = sharedTrendState == 1
sharedTrendBearish = sharedTrendState == -1

rawLongCandidate = TradingPreset == "Futures" ? futuresTrailLongCandidate : TradingPreset == "Scalping" ? (investorLongCandidate or scalpingBullishScoreChange) : useInvestorSignalMode ? investorLongCandidate : useCatcherSignalMode ? trendCatcherLongCandidate : componentLongCandidate
rawShortCandidate = TradingPreset == "Futures" ? futuresTrailShortCandidate : TradingPreset == "Scalping" ? (investorShortCandidate or scalpingBearishScoreChange) : useInvestorSignalMode ? investorShortCandidate : useCatcherSignalMode ? trendCatcherShortCandidate : componentShortCandidate

// ---- DYNAMIC: distance from the Smart Trail (ATR, + = on the trade side), volume z, confidence gate ----
longTrailDistAtr  = (close - activeTrailVisual) / atrSafe
shortTrailDistAtr = (activeTrailVisual - close) / atrSafe
volZ = nz((volume - ta.sma(volume, 20)) / math.max(ta.stdev(volume, 20), 1.0))
climaxBar = volZ > ClimaxVolumeZ
longConfPass  = activeModelConfidencePass or (activeModelConfidenceLevel == 2 and longTrailDistAtr >= 0 and longTrailDistAtr <= Conf2NearTrailAtr)
shortConfPass = activeModelConfidencePass or (activeModelConfidenceLevel == 2 and shortTrailDistAtr >= 0 and shortTrailDistAtr <= Conf2NearTrailAtr)
activeLongSignal  = rawLongCandidate  and longConfPass  and sharedTrendBullish
activeShortSignal = rawShortCandidate and shortConfPass and sharedTrendBearish
activeConfidenceLevel = activeModelConfidenceLevel

// ============================================================================================
// DYNAMIC: what the bot does with the signal (take / wait for retest / climax veto)
// ============================================================================================
anySignal = activeLongSignal or activeShortSignal
signalDistAtr = activeLongSignal and not na(longTrailDistAtr) ? longTrailDistAtr : activeShortSignal and not na(shortTrailDistAtr) ? shortTrailDistAtr : 0.0
signalVetoed = anySignal and climaxBar
signalFar    = anySignal and not climaxBar and signalDistAtr > ChaseAtr
signalTake   = anySignal and not climaxBar and signalDistAtr <= ChaseAtr

var int retestAge = 0
retestAge := signalFar ? 0 : retestAge[1] + 1
var int retestSide = 0
retestSide := signalFar ? (activeLongSignal ? 1 : -1) : retestAge >= RetestBars ? 0 : retestSide[1] == 1 and not sharedTrendBullish ? 0 : retestSide[1] == -1 and not sharedTrendBearish ? 0 : retestSide[1]
var float retestLvl = na
retestLvl := signalFar ? (activeLongSignal ? activeTrailVisual + RetestAtr * atrValue : activeTrailVisual - RetestAtr * atrValue) : retestSide == 0 ? na : retestLvl[1]
retestTouch = retestSide != 0 and not na(retestLvl) and not signalFar and ((retestSide == 1 and low <= retestLvl) or (retestSide == -1 and high >= retestLvl))
var int retestDone = 0
retestDone := signalFar ? 0 : retestTouch ? 1 : retestDone[1]
retestFirstFill = retestTouch and retestDone[1] == 0
retestOpen = retestSide != 0 and not na(retestLvl) and retestDone == 0

// bubble de-clutter: verdict code 1 = take, 2 = wait, 3 = veto; repeat only when the verdict changes or after the cooldown
verdict = signalVetoed ? 3 : signalFar ? 2 : signalTake ? 1 : 0
var int lastBubbleBar = 0
lastBubbleBar := verdict != 0 and (verdict != verdict[1] or bar_index - lastBubbleBar[1] > BubbleCooldownBars) ? bar_index : lastBubbleBar[1]
printBubble = verdict != 0 and lastBubbleBar == bar_index

// ============================================================================================
// TRADE LEVELS
// ============================================================================================
var int tradeDirection = 0
tradeDirection := activeLongSignal ? 1 : activeShortSignal ? -1 : tradeDirection[1]
var float tradeEntry = close
tradeEntry := (activeLongSignal or activeShortSignal) ? close : nz(tradeEntry[1], close)
var float tradeRisk = atrValue * StopAtrMultiplier
tradeRisk := (activeLongSignal or activeShortSignal) ? atrValue * StopAtrMultiplier : nz(tradeRisk[1], atrValue * StopAtrMultiplier)

stop1Level   = tradeDirection == 1 ? tradeEntry - tradeRisk * Stop1R   : tradeDirection == -1 ? tradeEntry + tradeRisk * Stop1R   : na
stop2Level   = tradeDirection == 1 ? tradeEntry - tradeRisk * Stop2R   : tradeDirection == -1 ? tradeEntry + tradeRisk * Stop2R   : na
target1Level = tradeDirection == 1 ? tradeEntry + tradeRisk * Target1R : tradeDirection == -1 ? tradeEntry - tradeRisk * Target1R : na
target2Level = tradeDirection == 1 ? tradeEntry + tradeRisk * Target2R : tradeDirection == -1 ? tradeEntry - tradeRisk * Target2R : na
target3Level = tradeDirection == 1 ? tradeEntry + tradeRisk * Target3R : tradeDirection == -1 ? tradeEntry - tradeRisk * Target3R : na

activeTrailBullish = TradingPreset == "Futures" ? futuresTrailBullish : useInvestorSignalMode ? investorTrend == 1 : useCatcherSignalMode ? catcherBullish : trailBullish
trailBandWidth = atrValue * TrailBandAtrWidth
trailBandUpper = activeTrailVisual + trailBandWidth
trailBandLower = activeTrailVisual - trailBandWidth

// ============================================================================================
// PLOTS: SMART TRAIL
// ============================================================================================
bullTrailUpperPlot = plot(showSmartTrail and ShowTrailFill and activeTrailBullish ? trailBandUpper : na, "Smart Trail Bull Upper", display = display.none)
bullTrailLowerPlot = plot(showSmartTrail and ShowTrailFill and activeTrailBullish ? trailBandLower : na, "Smart Trail Bull Lower", display = display.none)
bearTrailUpperPlot = plot(showSmartTrail and ShowTrailFill and not activeTrailBullish ? trailBandUpper : na, "Smart Trail Bear Upper", display = display.none)
bearTrailLowerPlot = plot(showSmartTrail and ShowTrailFill and not activeTrailBullish ? trailBandLower : na, "Smart Trail Bear Lower", display = display.none)
fill(bullTrailUpperPlot, bullTrailLowerPlot, color = color.new(colTrailBull, 70), title = "Smart Trail Bull Fill")
fill(bearTrailUpperPlot, bearTrailLowerPlot, color = color.new(colTrailBear, 70), title = "Smart Trail Bear Fill")

plot(showSmartTrail ? trailBandUpper : na, "Smart Trail Upper", color = color.new(chart.fg_color, 100), display = display.none)
plot(showSmartTrail ? trailBandLower : na, "Smart Trail Lower", color = color.new(chart.fg_color, 100), display = display.none)

// ============================================================================================
// PLOTS: TREND CATCHER
// ============================================================================================
catcherTrendColor = catcherBullish ? colBull : colBear
plot(showCatcher and ShowCatcherBoundaries ? catcherVisualUpper : na, "Catcher Upper", color = catcherTrendColor)
plot(showCatcher and ShowCatcherBoundaries ? catcherVisualLower : na, "Catcher Lower", color = catcherTrendColor)
plot(showCatcher and ShowCatcherCenterLine ? catcherVisualCenter : na, "Catcher Center", color = catcherTrendColor, linewidth = 1)

bullCatcherUpperPlot = plot(showCatcher and ShowCatcherFill and catcherBullish ? catcherVisualUpper : na, "Catcher Bull Upper", display = display.none)
bullCatcherLowerPlot = plot(showCatcher and ShowCatcherFill and catcherBullish ? catcherVisualLower : na, "Catcher Bull Lower", display = display.none)
bearCatcherUpperPlot = plot(showCatcher and ShowCatcherFill and not catcherBullish ? catcherVisualUpper : na, "Catcher Bear Upper", display = display.none)
bearCatcherLowerPlot = plot(showCatcher and ShowCatcherFill and not catcherBullish ? catcherVisualLower : na, "Catcher Bear Lower", display = display.none)
fill(bullCatcherUpperPlot, bullCatcherLowerPlot, color = color.new(colBull, 75), title = "Catcher Bull Fill")
fill(bearCatcherUpperPlot, bearCatcherLowerPlot, color = color.new(colBear, 75), title = "Catcher Bear Fill")

// ============================================================================================
// PLOTS: TREND TRACER
// ============================================================================================
plot(showTracer ? tracerValue : na, "Trend Tracer", color = tracerBullish ? colBull : colBear, linewidth = 2)

// ============================================================================================
// PLOTS: NEO CLOUD
// ============================================================================================
plot(showCloud ? cloudOuterUpper : na, "Neo Cloud Outer Upper", color = colNeoCloud, style = plot.style_linebr)
plot(showCloud ? cloudOuterLower : na, "Neo Cloud Outer Lower", color = colNeoCloud, style = plot.style_linebr)
neoOuterFillUpper = plot(showCloud and ShowCloudFill ? cloudOuterUpper : na, "Neo Cloud Outer Fill Upper", display = display.none)
neoOuterFillLower = plot(showCloud and ShowCloudFill ? cloudOuterLower : na, "Neo Cloud Outer Fill Lower", display = display.none)
fill(neoOuterFillUpper, neoOuterFillLower, color = color.new(colNeoFill, 55), title = "Neo Cloud Fill")

neoInnerUpperPlot = plot(showCloud and ShowCloudInnerRibbon ? visualCloudUpper : na, "Neo Cloud Inner Upper", color = colNeoCloud, display = showCloud and ShowCloudInnerRibbon ? display.all : display.none)
neoBasisPlot       = plot(showCloud and ShowCloudInnerRibbon ? visualCloudBasis : na, "Neo Cloud Basis", color = colNeoCloud, display = showCloud and ShowCloudInnerRibbon ? display.all : display.none)
neoInnerLowerPlot  = plot(showCloud and ShowCloudInnerRibbon ? visualCloudLower : na, "Neo Cloud Inner Lower", color = colNeoCloud, display = showCloud and ShowCloudInnerRibbon ? display.all : display.none)
fill(neoInnerUpperPlot, neoBasisPlot, color = color.new(cloudBullish ? colBull : colTrailBear, 80), title = "Neo Cloud Ribbon Upper")
fill(neoBasisPlot, neoInnerLowerPlot, color = color.new(cloudBullish ? colBull : colBear, 80), title = "Neo Cloud Ribbon Lower")

// ============================================================================================
// PLOTS: VWAP / ANCHORED VWAP / OPENING RANGE / HTF LEVELS
// ============================================================================================
plot(visualEnabled and ShowVwap ? sessionVwapValue : na, "Session VWAP", color = colTrailBull, linewidth = 2)
plot(visualEnabled and ShowAnchoredVwap ? anchoredVwapValue : na, "Anchored VWAP", color = colTrailBear, linewidth = 2)
plot(visualEnabled and ShowOpeningRange ? openingRangeHigh : na, "Opening Range High", color = colTrailBear, style = plot.style_linebr, linewidth = 1)
plot(visualEnabled and ShowOpeningRange ? openingRangeLow  : na, "Opening Range Low",  color = colTrailBear, style = plot.style_linebr, linewidth = 1)
plot(visualEnabled and ShowHtfLevels ? previousHtfHigh : na, "Previous HTF High", color = colBear, style = plot.style_linebr)
plot(visualEnabled and ShowHtfLevels ? previousHtfLow  : na, "Previous HTF Low",  color = colBull, style = plot.style_linebr)

// ============================================================================================
// BAR COLOR  (AssignPriceColor)
// ============================================================================================
barColor = not showTrendOverlay ? na : (bullishChoch or bearishChoch) ? colChochBar : sharedTrendState == 1 ? colBull : sharedTrendState == -1 ? colBear : colNeutral
barcolor(barColor, title = "Trend Overlay Bar Color")

// ============================================================================================
// TREND SQUARES  (SetPaintingStrategy SQUARES rail along the bottom of the chart)
// ============================================================================================
// Bar-relative placement (location.belowbar), not an absolute price coordinate: an all-time
// chartLow/chartHigh tracked via location.absolute can lock onto a stray extreme from deep,
// back-adjusted continuous-futures history and permanently distort the visible price axis.
plotshape(showTrendOverlay and not na(close), "Trend Squares", style = shape.square,
     location = location.belowbar, size = size.tiny,
     color = sharedTrendBullish ? colBull : sharedTrendBearish ? colBear : colNeutral)

// ============================================================================================
// SIGNAL / STRUCTURE / LIQUIDITY BUBBLES  (AddChartBubble)
// ============================================================================================
// ---- DYNAMIC: the original confidence bubbles, coloured by what the bot does:
// green/red = enters here, grey = signal the bot does not take (too far -> retest, or climax veto)
plainBubbles = visualEnabled and ShowConfidenceBubbles and not ShowDecisionBubbles
cooldownOk = BubbleCooldownBars == 0 or printBubble
if plainBubbles and activeLongSignal and cooldownOk
    label.new(bar_index, low, str.tostring(activeConfidenceLevel), color = signalTake ? colBull : colGrey, textcolor = color.white, style = label.style_label_up, size = size.small)
if plainBubbles and activeShortSignal and cooldownOk
    label.new(bar_index, high, str.tostring(activeConfidenceLevel), color = signalTake ? colBear : colGrey, textcolor = color.white, style = label.style_label_down, size = size.small)

// ---- DYNAMIC: verbose decision bubbles = "confidence | ATR from trail" + verdict (grey CLX = climax veto, purple wait = retest parked)
decisionText = str.tostring(activeConfidenceLevel) + " | " + str.tostring(math.round(signalDistAtr, 1)) + "A" + (signalVetoed ? " CLX" : signalFar ? " wait " + str.tostring(math.round(retestLvl, 0)) : "")
if showSignals and ShowDecisionBubbles and activeLongSignal and printBubble
    label.new(bar_index, low, decisionText, color = signalVetoed ? colGrey : signalFar ? colNeutral : colBull, textcolor = color.white, style = label.style_label_up, size = size.small)
if showSignals and ShowDecisionBubbles and activeShortSignal and printBubble
    label.new(bar_index, high, decisionText, color = signalVetoed ? colGrey : signalFar ? colNeutral : colBear, textcolor = color.white, style = label.style_label_down, size = size.small)

// RETEST bubble on the first touch of the parked retest level (shown in either bubble mode)
if retestFirstFill and (plainBubbles or (showSignals and ShowDecisionBubbles))
    label.new(bar_index, retestSide == 1 ? low : high, "RETEST", color = retestSide == 1 ? colBull : colBear, textcolor = color.white, style = retestSide == 1 ? label.style_label_up : label.style_label_down, size = size.small)

plot(visualEnabled and retestOpen ? retestLvl : na, "Retest Level", color = retestSide == 1 ? colBull : colBear, linewidth = 2, style = plot.style_linebr, linestyle = plot.linestyle_dashed)

// ---- DYNAMIC: entry arrows = the bars the bot actually enters on (market take, or the retest fill)
longTakeBar  = (activeLongSignal and signalTake) or (retestFirstFill and retestSide == 1)
shortTakeBar = (activeShortSignal and signalTake) or (retestFirstFill and retestSide == -1)
plotshape(ShowEntryArrows and longTakeBar, "Long Entry Arrow", style = shape.arrowup, location = location.belowbar, color = colBull, size = size.normal)
plotshape(ShowEntryArrows and shortTakeBar, "Short Entry Arrow", style = shape.arrowdown, location = location.abovebar, color = colBear, size = size.normal)
if visualEnabled and ShowStructure and bullishStructureBreak
    label.new(bar_index, low, bullishChoch ? "CHoCH" : "BOS", color = bullishChoch ? colBullChoch : colBull, textcolor = color.white, style = label.style_label_up, size = size.small)
if visualEnabled and ShowStructure and bearishStructureBreak
    label.new(bar_index, high, bearishChoch ? "CHoCH" : "BOS", color = bearishChoch ? colBearChoch : colBear, textcolor = color.white, style = label.style_label_down, size = size.small)
if visualEnabled and ShowLiquidity and buySideSweep
    label.new(bar_index, high, "X", color = colTrailBear, textcolor = color.white, style = label.style_label_down, size = size.small)
if visualEnabled and ShowLiquidity and sellSideSweep
    label.new(bar_index, low, "X", color = colNeoCloud, textcolor = color.white, style = label.style_label_up, size = size.small)

// ============================================================================================
// ML SCORE LABEL  (persistent, updates on the last bar only)
// ============================================================================================
plot(visualEnabled and ShowModelScoreHistory ? activeModelScore : na, "Model Score History", display = display.none)

var label mlScoreLabel = na
if showMlScore and ShowMlLabel and barstate.islast
    label.delete(mlScoreLabel)
    mlScoreText = "Model Score  " + str.tostring(math.round(activeModelScore * 10) / 10) + "\n" +
         (activeModelScore >= MlBullThreshold ? "Bullish" : activeModelScore <= MlBearThreshold ? "Bearish" : "Neutral") + "\n" +
         "Confidence  " + str.tostring(activeConfidenceLevel) + "/5"
    mlScoreColor = activeModelScore >= MlBullThreshold ? colBull : activeModelScore <= MlBearThreshold ? colBear : colNeutral
    mlScoreLabel := label.new(bar_index, high + atrValue, mlScoreText, color = mlScoreColor, textcolor = color.white, style = label.style_label_down, size = size.small)

// ============================================================================================
// TRADE LEVEL LINES + BUBBLES  (last bar only, persistent)
// ============================================================================================
var line sl1Line = na
var line sl2Line = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na
var label entryLabel = na
var label sl1Label = na
var label sl2Label = na
var label tp1Label = na
var label tp2Label = na
var label tp3Label = na

if visualEnabled and ShowLevels and barstate.islast
    line.delete(sl1Line)
    line.delete(sl2Line)
    line.delete(tp1Line)
    line.delete(tp2Line)
    line.delete(tp3Line)
    label.delete(entryLabel)
    label.delete(sl1Label)
    label.delete(sl2Label)
    label.delete(tp1Label)
    label.delete(tp2Label)
    label.delete(tp3Label)

    lineFrom = bar_index - 20
    if not na(stop1Level)
        sl1Line := line.new(lineFrom, stop1Level, bar_index, stop1Level, color = colStop, style = line.style_dashed)
        sl1Label := label.new(bar_index, stop1Level, "SL1 " + str.tostring(math.round(stop1Level * 100) / 100), color = colStop, textcolor = color.white, style = tradeDirection == -1 ? label.style_label_up : label.style_label_down, size = size.small)
    if not na(stop2Level)
        sl2Line := line.new(lineFrom, stop2Level, bar_index, stop2Level, color = colStop, style = line.style_dashed)
        sl2Label := label.new(bar_index, stop2Level, "SL2 " + str.tostring(math.round(stop2Level * 100) / 100), color = colStop, textcolor = color.white, style = tradeDirection == -1 ? label.style_label_up : label.style_label_down, size = size.small)
    if not na(target1Level)
        tp1Line := line.new(lineFrom, target1Level, bar_index, target1Level, color = colTarget, style = line.style_dashed)
        tp1Label := label.new(bar_index, target1Level, "TP1 " + str.tostring(math.round(target1Level * 100) / 100), color = colTarget, textcolor = color.white, style = tradeDirection == 1 ? label.style_label_down : label.style_label_up, size = size.small)
    if not na(target2Level)
        tp2Line := line.new(lineFrom, target2Level, bar_index, target2Level, color = colTarget, style = line.style_dashed)
        tp2Label := label.new(bar_index, target2Level, "TP2 " + str.tostring(math.round(target2Level * 100) / 100), color = colTarget, textcolor = color.white, style = tradeDirection == 1 ? label.style_label_down : label.style_label_up, size = size.small)
    if not na(target3Level)
        tp3Line := line.new(lineFrom, target3Level, bar_index, target3Level, color = colTarget, style = line.style_dashed)
        tp3Label := label.new(bar_index, target3Level, "TP3 " + str.tostring(math.round(target3Level * 100) / 100), color = colTarget, textcolor = color.white, style = tradeDirection == 1 ? label.style_label_down : label.style_label_up, size = size.small)
    if not na(tradeEntry)
        entryLabel := label.new(bar_index, tradeEntry, "Entry " + str.tostring(math.round(tradeEntry * 100) / 100), color = colEntry, textcolor = color.white, style = tradeDirection == -1 ? label.style_label_up : label.style_label_down, size = size.small)

// ============================================================================================
// READOUT STRIP  (AddLabel equivalents, laid out like the Daily Bias / Px vs EMA readouts:
// one row of coloured chips per label, with an edge-offset spacer so it stacks under them)
//   row 1: ZONE verdict | conf | ATR from trail | volZ | reason        (last closed bar)
//   row 2: last signal  | conf | ATR from trail | bot decision          (last closed bar)
//   row 3: RVOL / Strength / Squeeze / Volume / KNN chips (when enabled)
// ============================================================================================
// DYNAMIC labels are evaluated on the last CLOSED bar (the bot's view). On the forming bar the trend/confidence
// flip intrabar, which is the LONG -> SHORT -> LONG flicker; the bot never sees that bar until it closes.
f_fmt(_v, _dec) =>
    na(_v) ? "—" : str.tostring(math.round(_v, _dec))

f_signed(_v, _dec) =>
    na(_v) ? "—" : (_v >= 0 ? "+" : "") + str.tostring(math.round(_v, _dec))

lblTrend = sharedTrendState[1]
lblConf = activeConfidenceLevel[1]
lblClimax = climaxBar[1]
lblVolZ = volZ[1]
curTrailDistAtr = lblTrend == 1 ? longTrailDistAtr[1] : lblTrend == -1 ? shortTrailDistAtr[1] : na

// zone verdict for the current bar: green LONG ZONE, red SHORT ZONE, grey NO TRADE (with the reason)
confOk = lblConf >= MinMlConfidence or (lblConf == 2 and curTrailDistAtr <= Conf2NearTrailAtr)
zoneOk = not na(curTrailDistAtr) and curTrailDistAtr >= 0 and curTrailDistAtr <= ChaseAtr and not lblClimax and confOk
labelLong = zoneOk and lblTrend == 1
labelShort = zoneOk and lblTrend == -1
labelReason = retestOpen ? 1 : na(curTrailDistAtr) ? 2 : lblClimax ? 3 : curTrailDistAtr > ChaseAtr ? 4 : not confOk ? 5 : 0
reasonText = labelReason == 1 ? "Waiting " + (retestSide == 1 ? "long" : "short") + " pullback " + f_fmt(retestLvl, 2) + " (" + str.tostring(RetestBars - retestAge) + " bars)" :
     labelReason == 2 ? "No trend" :
     labelReason == 3 ? "Climax bar" :
     labelReason == 4 ? "Too far from trail" :
     labelReason == 5 ? "Conf 2 needs ≤ " + str.tostring(Conf2NearTrailAtr) + " ATR" : ""

// the last CLOSED bar's signal event and the bot's decision on it
sigL1 = activeLongSignal[1]
sigS1 = activeShortSignal[1]
fill1 = retestFirstFill[1]
fillSide1 = retestSide[1]
sigLong1 = fill1 ? fillSide1 == 1 : sigL1
hasSig1 = fill1 or sigL1 or sigS1
take1 = signalTake[1]
far1 = signalFar[1]
veto1 = signalVetoed[1]
sigDist1 = signalDistAtr[1]
sigRetest1 = nz(retestLvl[1])

// chip colours (bright fills with contrasting text, same palette as the chart markers)
colChipDark = color.rgb(67, 70, 81)
f_confBg(_c) =>
    _c >= 4 ? colNeutral : _c >= MinMlConfidence ? color.rgb(126, 87, 194) : _c == 2 ? colChipDark : color.gray
f_distBg(_d) =>
    na(_d) or _d < 0 ? color.gray : _d > ChaseAtr ? colTrailBear : colTrailBull
f_distFg(_d) =>
    na(_d) or _d < 0 ? color.white : color.black

ReadoutPos    = input.string("Top Right", "Readout Position", options = ["Top Left", "Top Center", "Top Right", "Bottom Left", "Bottom Center", "Bottom Right"], group = "Readout")
ReadoutOffset = input.float(12.0, "Readout Edge Offset (% of pane)", minval = 0, maxval = 50, step = 1, tooltip = "Pushes the strip away from the pane edge so it stacks under the Px vs EMA (6) and Daily Bias (9) readouts", group = "Readout")
ReadoutSizeIn = input.string("Normal", "Readout Text Size", options = ["Small", "Normal", "Large"], group = "Readout")
ReadoutHelp   = input.bool(true, "Readout Help Tooltips", tooltip = "Hover any readout chip for an explanation of what it means", group = "Readout")

readoutPosition = switch ReadoutPos
    "Top Left"      => position.top_left
    "Top Center"    => position.top_center
    "Bottom Left"   => position.bottom_left
    "Bottom Center" => position.bottom_center
    "Bottom Right"  => position.bottom_right
    => position.top_right
readoutSize = ReadoutSizeIn == "Small" ? size.small : ReadoutSizeIn == "Large" ? size.large : size.normal
readoutTop  = str.startswith(ReadoutPos, "Top")

// rows: spacer + zone + signal + info (the spacer sits on the pane-edge side)
var table readout = table.new(readoutPosition, 5, 4, border_width = 1, border_color = color.new(color.black, 100))

f_chip(_col, _row, _text, _bg, _fg, _tip = "") =>
    table.cell(readout, _col, _row, _text, bgcolor = _bg, text_color = _fg, text_size = readoutSize, tooltip = ReadoutHelp ? _tip : "")

// hover help for the readout chips (thresholds pulled from the live inputs)
tipZone   = "ZONE ROW — is it OK to be in a trade right now? (last closed bar)\nLONG/SHORT ZONE: trend is up/down, price is 0–" + str.tostring(ChaseAtr) + " ATR from the trail, confidence is high enough, and no climax bar.\nNO TRADE: one of those failed — the grey chip at the end says which."
tipConf   = "Confidence 1–5: the scoring model's rating of the current trend, bucketed into 5 levels.\nBlue (4–5) or purple (≥ " + str.tostring(MinMlConfidence) + ") = tradeable. Dark = 2 (only OK within " + str.tostring(Conf2NearTrailAtr) + " ATR of the trail). Grey = too low."
tipDist   = "Distance from the trailing stop, in ATRs.\nGreen = 0–" + str.tostring(ChaseAtr) + " ATR (good entry area). Red = more than " + str.tostring(ChaseAtr) + " ATR away (chasing). Grey = wrong side of trail / no trend."
tipVolZ   = "Volume z-score vs the 20-bar average (0 = normal, +2 = unusually heavy).\nTurns red above " + str.tostring(ClimaxVolumeZ) + " = climax bar, which blocks new entries."
tipReason = "Why the zone is NO TRADE (or what it is waiting for)."
tipSig    = "SIGNAL ROW — did a signal fire on the last closed bar, and what did the bot do with it?\nShows 'No signal' on every other bar, so it only duplicates the zone row on the bar right after a signal."
tipSigDst = "How far price was from the trail (in ATRs) when the signal fired."
tipEnter  = "BOT ENTERS: the signal passed every check and the bot takes the trade."
tipSkip   = "SKIPPED: the signal bar was a climax (volume) bar, so the bot ignores it."
tipChase  = "NOT CHASED: price was too far from the trail. The bot waits for a pullback to this level for up to " + str.tostring(RetestBars) + " bars."
tipFill   = "ENTRY: an earlier NOT CHASED signal got its pullback and the bot entered at this level."

if barstate.islast
    table.clear(readout, 0, 0, 4, 3)
    spacerRow = readoutTop ? 0 : 3
    zoneRow   = readoutTop ? 1 : 0
    sigRow    = readoutTop ? 2 : 1
    infoRow   = readoutTop ? 3 : 2
    if ReadoutOffset > 0
        table.cell(readout, 0, spacerRow, "", height = ReadoutOffset)

    if ShowDynamicLabel
        f_chip(0, zoneRow, labelLong ? "LONG ZONE" : labelShort ? "SHORT ZONE" : "NO TRADE",
             labelLong ? colBull : labelShort ? colBear : color.gray, labelLong ? color.black : color.white, tipZone)
        f_chip(1, zoneRow, "Conf " + str.tostring(lblConf) + "/5", f_confBg(lblConf), color.white, tipConf)
        f_chip(2, zoneRow, f_signed(curTrailDistAtr, 1) + " ATR", f_distBg(curTrailDistAtr), f_distFg(curTrailDistAtr), tipDist)
        f_chip(3, zoneRow, "volZ " + f_signed(lblVolZ, 1), lblClimax ? colTrailBear : colChipDark, lblClimax ? color.black : color.white, tipVolZ)
        if labelReason != 0
            f_chip(4, zoneRow, reasonText, labelReason == 1 ? colNeutral : colChipDark, color.white, tipReason)

    if ShowSignalLabel
        if not hasSig1
            f_chip(0, sigRow, "No signal", colChipDark, color.white, tipSig)
        else if fill1
            f_chip(0, sigRow, sigLong1 ? "LONG ENTRY" : "SHORT ENTRY", sigLong1 ? colBull : colBear, sigLong1 ? color.black : color.white, tipFill)
            f_chip(1, sigRow, "Pullback fill " + f_fmt(sigRetest1, 2), colNeutral, color.white, tipFill)
        else
            takeBg = sigLong1 ? colBull : colBear
            f_chip(0, sigRow, sigLong1 ? "LONG signal" : "SHORT signal", take1 ? takeBg : color.gray, take1 and sigLong1 ? color.black : color.white, tipSig)
            f_chip(1, sigRow, "Conf " + str.tostring(lblConf) + "/5", f_confBg(lblConf), color.white, tipConf)
            f_chip(2, sigRow, f_signed(sigDist1, 1) + " ATR", f_distBg(sigDist1), f_distFg(sigDist1), tipSigDst)
            if veto1
                f_chip(3, sigRow, "SKIPPED: climax bar", colTrailBear, color.black, tipSkip)
            else if far1
                f_chip(3, sigRow, "NOT CHASED: pullback " + f_fmt(sigRetest1, 2), colNeutral, color.white, tipChase)
            else
                f_chip(3, sigRow, "BOT ENTERS", takeBg, sigLong1 ? color.black : color.white, tipEnter)

    col = 0
    if ShowRegime and visualEnabled
        f_chip(col, infoRow, "RVOL " + f_fmt(relativeVolumeValue, 2) + " | ATR Regime " + f_fmt(volatilityRegimeValue, 2), colNeutral, color.white)
        col += 1
    if ShowStrength and visualEnabled
        f_chip(col, infoRow, "Strength " + f_fmt(strengthValue, 2) + "%", colNeutral, color.white)
        col += 1
    if ShowSqueeze and visualEnabled
        f_chip(col, infoRow, "Squeeze " + f_fmt(squeezeValue, 2) + "%", colNeutral, color.white)
        col += 1
    if ShowVolumeSentiment and visualEnabled
        f_chip(col, infoRow, "Volume " + f_fmt(volumeSentimentValue, 2) + "%", colNeutral, color.white)
        col += 1
    if UseKnnFilter
        f_chip(col, infoRow, "KNN omitted: pass-through", color.gray, color.white)
        col += 1

// ============================================================================================
// ALERTS
// ============================================================================================
// climax-vetoed signals do not alert (the bot skips them)
alertcondition(activeLongSignal and not signalVetoed, title = "Bullish ML Confidence Signal", message = "Bullish ML Confidence Signal")
alertcondition(activeShortSignal and not signalVetoed, title = "Bearish ML Confidence Signal", message = "Bearish ML Confidence Signal")
alertcondition(retestFirstFill, title = "LASOMA Retest Touched", message = "LASOMA retest level touched")

if EnableAlerts and activeLongSignal and not signalVetoed
    alert("Bullish ML Confidence Signal", alert.freq_once_per_bar_close)
if EnableAlerts and activeShortSignal and not signalVetoed
    alert("Bearish ML Confidence Signal", alert.freq_once_per_bar_close)
if EnableAlerts and retestFirstFill
    alert("LASOMA retest level touched", alert.freq_once_per_bar_close)

// ============================================================================================
// SCAN  (TOS drop-down scan extension -> hidden 1/0 "Scan" plot for Pine Screener + alert condition)
// ============================================================================================
ScanChoice = input.string("Bullish Signal Flip", "Scan Mode", options = ["Bullish Signal Flip", "Bearish Signal Flip", "Bullish Trend Flip", "Bearish Trend Flip",
     "ML Score Bullish Flip (60+)", "ML Score Bearish Flip (40-)", "High Confidence Bullish (L4+)", "High Confidence Bearish (L4+)",
     "Scalping Bullish Score Change", "Scalping Bearish Score Change"], group = "Scan")

scanIsMinConfidenceMet = activeConfidenceLevel >= MinMlConfidence
scanIsHighConfidence   = activeConfidenceLevel >= 4
scanConfidenceUpgraded = activeConfidenceLevel > activeConfidenceLevel[1]
scanBullishSignalFlip  = activeLongSignal and not activeLongSignal[1]
scanBearishSignalFlip  = activeShortSignal and not activeShortSignal[1]
scanBullishTrendFlip   = sharedTrendBullish and not sharedTrendBullish[1]
scanBearishTrendFlip   = sharedTrendBearish and not sharedTrendBearish[1]
scanMlScoreBullishFlip = activeModelScore >= MlBullThreshold and activeModelScore[1] < MlBullThreshold
scanMlScoreBearishFlip = activeModelScore <= MlBearThreshold and activeModelScore[1] > MlBearThreshold

scanCondition = switch ScanChoice
    "Bullish Signal Flip"           => scanBullishSignalFlip
    "Bearish Signal Flip"           => scanBearishSignalFlip
    "Bullish Trend Flip"            => scanBullishTrendFlip and scanIsMinConfidenceMet
    "Bearish Trend Flip"            => scanBearishTrendFlip and scanIsMinConfidenceMet
    "ML Score Bullish Flip (60+)"   => scanMlScoreBullishFlip and scanIsMinConfidenceMet
    "ML Score Bearish Flip (40-)"   => scanMlScoreBearishFlip and scanIsMinConfidenceMet
    "High Confidence Bullish (L4+)" => sharedTrendBullish and scanIsHighConfidence and (scanBullishTrendFlip or scanConfidenceUpgraded)
    "High Confidence Bearish (L4+)" => sharedTrendBearish and scanIsHighConfidence and (scanBearishTrendFlip or scanConfidenceUpgraded)
    "Scalping Bullish Score Change" => scalpingBullishScoreChange
    "Scalping Bearish Score Change" => scalpingBearishScoreChange
    => false

plot(scanCondition ? 1 : 0, "Scan", display = display.data_window)
alertcondition(scanCondition, title = "LASOMA Scan Match", message = "LASOMA scan match")

