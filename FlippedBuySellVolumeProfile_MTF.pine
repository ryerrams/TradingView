//@version=6
indicator("Flipped Buy/Sell Volume Profile [MTF]", overlay=true, max_boxes_count=500, max_lines_count=50, max_labels_count=50)

// Pine port of FlippedBuySellVolumeProfile_MTF.ts (a ThinkScript study for thinkorswim).
// Pine has no MonkeyBars/VolumeProfile built-ins, so the histogram is rebuilt from
// bar-by-bar volume distributed into price rows, drawn as boxes anchored to the right
// of the last bar and growing LEFT (the "flipped" look). Only the current/live profile
// is drawn, matching the original's onExpansion=yes behavior; it resets each time a new
// profile period starts. If the boxes look squeezed against the price axis, increase the
// chart's right margin (drag the price scale, or right-click it > settings).
//
// Buy/sell pressure is still just an estimate from each bar's close location
// within its high-low range -- not real bid/ask aggressor volume.

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------
rowHeightModeInput = input.string("Automatic", "Row Height Mode", options = ["Automatic", "Tick Size", "Custom"], group = "Profile")
customRowHeight    = input.float(1.0, "Custom Row Height", minval = 0.00001, group = "Profile")

profilePeriodInput = input.string("Day", "Profile Period", options = ["Chart", "Minute", "Hour", "Day", "Week", "Month", "Bar"], group = "Profile")
multiplier         = input.int(1, "Combine N Periods Into One Profile", minval = 1, group = "Profile")

showPointOfControl   = input.bool(true, "Show Point of Control", group = "Profile")
showValueArea        = input.bool(true, "Show Value Area Shading", group = "Profile")
showValueAreaLines   = input.bool(true, "Show VAH/VAL Lines", group = "Profile")
valueAreaPercent     = input.float(70, "Value Area %", minval = 1, maxval = 99, group = "Profile")
opacityInput         = input.int(50, "Profile Opacity", minval = 0, maxval = 100, group = "Profile")
gapBars              = input.int(6, "Gap From Last Bar (bars)", minval = 0, group = "Profile")
maxWidthBars         = input.int(40, "Max Profile Width (bars)", minval = 5, group = "Profile")

pressureThreshold  = input.float(52.0, "Pressure Threshold %", group = "Buy/Sell Pressure")
showPressureLabel  = input.bool(true, "Show Pressure Label", group = "Buy/Sell Pressure")
showMultiTFStrip   = input.bool(true, "Show Multi-TF Buy% Strip", group = "Buy/Sell Pressure")

// ---------------------------------------------------------------------------
// Colors
// ---------------------------------------------------------------------------
volumeProfileColor = color.new(color.rgb(70, 130, 180), 100 - opacityInput)
valueAreaColor     = color.new(color.rgb(160, 110, 210), 100 - opacityInput)
pocColor           = color.new(color.yellow, 100 - opacityInput)
buyingColor        = color.rgb(0, 175, 90)
sellingColor       = color.rgb(210, 55, 55)
balancedColor      = color.rgb(120, 120, 120)
vahColor           = color.green
valColor           = color.red

// ---------------------------------------------------------------------------
// Profile period boundaries (wall-clock based, like the original's period switch)
// ---------------------------------------------------------------------------
bool rawNewPeriod = switch profilePeriodInput
    "Chart"  => false
    "Minute" => ta.change(time("1")) != 0
    "Hour"   => ta.change(time("60")) != 0
    "Day"    => ta.change(time("1D")) != 0
    "Week"   => ta.change(time("1W")) != 0
    "Month"  => ta.change(time("1M")) != 0
    "Bar"    => true
    => false

var int boundaryCount = 0
if rawNewPeriod
    boundaryCount += 1

bool startNewProfile = bar_index == 0 or (rawNewPeriod and math.floor(boundaryCount / multiplier) != math.floor((boundaryCount - 1) / multiplier))

// ---------------------------------------------------------------------------
// Row height -- frozen for the life of a profile. Recomputing this every bar
// would shift every bin's price mapping out from under the accumulated data.
// ---------------------------------------------------------------------------
float autoRowHeightRaw = math.max((ta.highest(200) - ta.lowest(200)) / 40, syminfo.mintick)

var float rowHeight = na
if startNewProfile or na(rowHeight)
    rowHeight := switch rowHeightModeInput
        "Automatic" => autoRowHeightRaw
        "Tick Size" => syminfo.mintick
        "Custom"    => customRowHeight
        => autoRowHeightRaw

// ---------------------------------------------------------------------------
// Estimated buy/sell pressure (per bar)
// ---------------------------------------------------------------------------
f_buyPct(h, l, c, v) =>
    rng = math.max(h - l, syminfo.mintick)
    float buyVol = h > l ? v * (c - l) / rng : v * 0.5
    float sellVol = v - buyVol
    float tot = buyVol + sellVol
    tot > 0 ? 100.0 * buyVol / tot : 50.0

bool validBar = not na(close) and not na(volume)
float barRange = math.max(high - low, syminfo.mintick)

float estimatedBuyVolume  = validBar ? (high > low ? volume * (close - low) / barRange : volume * 0.5) : 0.0
float estimatedSellVolume = validBar ? volume - estimatedBuyVolume : 0.0

var float profileBuyVolume  = 0.0
var float profileSellVolume = 0.0

if startNewProfile
    profileBuyVolume  := estimatedBuyVolume
    profileSellVolume := estimatedSellVolume
else if validBar
    profileBuyVolume  += estimatedBuyVolume
    profileSellVolume += estimatedSellVolume

float profileTotalVolume = profileBuyVolume + profileSellVolume
float buyPercent  = profileTotalVolume > 0 ? 100.0 * profileBuyVolume / profileTotalVolume : 50.0
float sellPercent = 100.0 - buyPercent
bool buyDominant  = buyPercent >= pressureThreshold
bool sellDominant = sellPercent >= pressureThreshold

// ---------------------------------------------------------------------------
// Multi-timeframe Buy% strip (1m/5m/15m/30m/1h)
// Each higher-TF bar returned here IS the accumulation of this chart's own
// bars within that window, so its own close-in-range estimate reproduces the
// original's wall-clock bucket accumulation without re-implementing it.
// ---------------------------------------------------------------------------
[h1, l1, c1, v1]   = request.security(syminfo.tickerid, "1",  [high, low, close, volume], lookahead = barmerge.lookahead_off)
[h5, l5, c5, v5]   = request.security(syminfo.tickerid, "5",  [high, low, close, volume], lookahead = barmerge.lookahead_off)
[h15, l15, c15, v15] = request.security(syminfo.tickerid, "15", [high, low, close, volume], lookahead = barmerge.lookahead_off)
[h30, l30, c30, v30] = request.security(syminfo.tickerid, "30", [high, low, close, volume], lookahead = barmerge.lookahead_off)
[h60, l60, c60, v60] = request.security(syminfo.tickerid, "60", [high, low, close, volume], lookahead = barmerge.lookahead_off)

float mtfPct1  = f_buyPct(h1, l1, c1, v1)
float mtfPct5  = f_buyPct(h5, l5, c5, v5)
float mtfPct15 = f_buyPct(h15, l15, c15, v15)
float mtfPct30 = f_buyPct(h30, l30, c30, v30)
float mtfPct60 = f_buyPct(h60, l60, c60, v60)

float mtfSellThresh = 100.0 - pressureThreshold
bool chartTooCoarse = timeframe.in_seconds(timeframe.period) > 60

f_cellColor(pct) => pct >= pressureThreshold ? buyingColor : pct <= mtfSellThresh ? sellingColor : balancedColor

// ---------------------------------------------------------------------------
// Volume profile bins (sparse-but-dense array, grown as needed, capped)
// ---------------------------------------------------------------------------
var array<float> binBuy  = array.new_float(0)
var array<float> binSell = array.new_float(0)
var int baseBinIndex = na
var int MAX_BINS = 300
var int MAX_ROWS_PER_BAR = 60

if startNewProfile
    array.clear(binBuy)
    array.clear(binSell)
    baseBinIndex := na

f_ensureBin(idx, base) =>
    int newBase = base
    int relIdx = na
    if na(base)
        newBase := idx
        array.push(binBuy, 0.0)
        array.push(binSell, 0.0)
        relIdx := 0
    else if idx < base
        int prependCount = math.max(math.min(base - idx, MAX_BINS - array.size(binBuy)), 0)
        if prependCount > 0
            for i = 1 to prependCount
                array.unshift(binBuy, 0.0)
                array.unshift(binSell, 0.0)
        newBase := base - prependCount
        relIdx := math.max(idx - newBase, 0)
    else if idx >= base + array.size(binBuy)
        int appendCount = math.max(math.min(idx - (base + array.size(binBuy)) + 1, MAX_BINS - array.size(binBuy)), 0)
        if appendCount > 0
            for i = 1 to appendCount
                array.push(binBuy, 0.0)
                array.push(binSell, 0.0)
        relIdx := math.min(idx - base, array.size(binBuy) - 1)
    else
        relIdx := idx - base
    [relIdx, newBase]

if validBar and rowHeight > 0
    int lowIdx  = int(math.floor(low / rowHeight))
    int highIdx = int(math.floor(high / rowHeight))
    int nRows   = math.min(highIdx - lowIdx + 1, MAX_ROWS_PER_BAR)
    for bi = 0 to nRows - 1
        int absIdx = lowIdx + bi
        float rowLow  = absIdx * rowHeight
        float rowHigh = rowLow + rowHeight
        float overlap = math.max(math.min(high, rowHigh) - math.max(low, rowLow), 0.0)
        float frac = barRange > 0 ? overlap / barRange : (bi == 0 ? 1.0 : 0.0)
        [relIdx, newBase] = f_ensureBin(absIdx, baseBinIndex)
        baseBinIndex := newBase
        array.set(binBuy, relIdx, array.get(binBuy, relIdx) + estimatedBuyVolume * frac)
        array.set(binSell, relIdx, array.get(binSell, relIdx) + estimatedSellVolume * frac)

// ---------------------------------------------------------------------------
// Draw the live profile (only on the last bar, redrawn each tick)
// ---------------------------------------------------------------------------
var array<box> profileBoxes = array.new_box(0)
var line vahLine = na
var line valLine = na
var label vahLabel = na
var label valLabel = na

if barstate.islast
    for b in profileBoxes
        box.delete(b)
    array.clear(profileBoxes)
    line.delete(vahLine)
    line.delete(valLine)
    label.delete(vahLabel)
    label.delete(valLabel)

    int nBins = array.size(binBuy)
    if nBins > 0
        float maxVol = 0.0
        int pocRel = 0
        float totalVol = 0.0
        for i = 0 to nBins - 1
            float v = array.get(binBuy, i) + array.get(binSell, i)
            totalVol += v
            if v > maxVol
                maxVol := v
                pocRel := i

        int vaLowRel = pocRel
        int vaHighRel = pocRel
        float vaVol = array.get(binBuy, pocRel) + array.get(binSell, pocRel)
        float targetVol = totalVol * valueAreaPercent / 100.0
        for i = 0 to nBins - 1
            if vaVol >= targetVol or (vaLowRel <= 0 and vaHighRel >= nBins - 1)
                break
            float volBelow = vaLowRel > 0 ? array.get(binBuy, vaLowRel - 1) + array.get(binSell, vaLowRel - 1) : -1.0
            float volAbove = vaHighRel < nBins - 1 ? array.get(binBuy, vaHighRel + 1) + array.get(binSell, vaHighRel + 1) : -1.0
            if volAbove >= volBelow
                vaHighRel += 1
                vaVol += math.max(volAbove, 0.0)
            else
                vaLowRel -= 1
                vaVol += math.max(volBelow, 0.0)

        int anchorBar = bar_index + gapBars

        for i = 0 to nBins - 1
            float rowVol = array.get(binBuy, i) + array.get(binSell, i)
            float width = maxVol > 0 ? (rowVol / maxVol) * maxWidthBars : 0.0
            int x2 = anchorBar
            int x1 = anchorBar - math.round(width)
            float y1 = (baseBinIndex + i) * rowHeight
            float y2 = y1 + rowHeight
            bool isPoc = i == pocRel
            bool inVA = i >= vaLowRel and i <= vaHighRel
            color rowColor = isPoc and showPointOfControl ? pocColor : (inVA and showValueArea ? valueAreaColor : volumeProfileColor)
            box newBox = box.new(x1, y1, x2, y2, border_color = color.new(rowColor, 40), bgcolor = rowColor)
            array.push(profileBoxes, newBox)

        if showValueAreaLines
            float vahPrice = (baseBinIndex + vaHighRel + 1) * rowHeight
            float valPrice = (baseBinIndex + vaLowRel) * rowHeight
            vahLine := line.new(anchorBar - maxWidthBars, vahPrice, anchorBar + 5, vahPrice, color = vahColor, width = 2)
            valLine := line.new(anchorBar - maxWidthBars, valPrice, anchorBar + 5, valPrice, color = valColor, width = 2)
            vahLabel := label.new(anchorBar + 5, vahPrice, "VAH", color = color.new(color.black, 100), textcolor = vahColor, style = label.style_label_left, size = size.small)
            valLabel := label.new(anchorBar + 5, valPrice, "VAL", color = color.new(color.black, 100), textcolor = valColor, style = label.style_label_left, size = size.small)

// ---------------------------------------------------------------------------
// Labels: pressure + multi-TF strip
// ---------------------------------------------------------------------------
var table strip = table.new(position.top_right, 7, 1, border_width = 0)

if barstate.islast
    int col = 0
    if showPressureLabel
        color pcColor = buyDominant ? buyingColor : sellDominant ? sellingColor : balancedColor
        table.cell(strip, col, 0, "Buy " + str.tostring(math.round(buyPercent, 1)) + "% | Sell " + str.tostring(math.round(sellPercent, 1)) + "%", text_color = color.white, bgcolor = pcColor)
        col += 1
    if showMultiTFStrip
        table.cell(strip, col, 0, "1m " + str.tostring(math.round(mtfPct1)) + "%", text_color = color.white, bgcolor = f_cellColor(mtfPct1))
        col += 1
        table.cell(strip, col, 0, "5m " + str.tostring(math.round(mtfPct5)) + "%", text_color = color.white, bgcolor = f_cellColor(mtfPct5))
        col += 1
        table.cell(strip, col, 0, "15m " + str.tostring(math.round(mtfPct15)) + "%", text_color = color.white, bgcolor = f_cellColor(mtfPct15))
        col += 1
        table.cell(strip, col, 0, "30m " + str.tostring(math.round(mtfPct30)) + "%", text_color = color.white, bgcolor = f_cellColor(mtfPct30))
        col += 1
        table.cell(strip, col, 0, "1h " + str.tostring(math.round(mtfPct60)) + "%", text_color = color.white, bgcolor = f_cellColor(mtfPct60))
        col += 1
        if chartTooCoarse
            table.cell(strip, col, 0, "⚠ use 1m chart", text_color = color.white, bgcolor = color.orange)
